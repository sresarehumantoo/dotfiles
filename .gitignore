# OS
.DS_Store
Thumbs.db

# Editor swap/backup
*.swp
*.swo
*~

# Build output
bin/
powershell/

# AI assistants
.claude/
CLAUDE.md
.continue/
.cursorrules
.cursorignore
.aider*
.copilot/
.github/copilot-*

# Environment / secrets
.env
.env.*

# Host-specific config. Output identifiers embed panel serial numbers, so the
# real file is machine identity, not shareable config. Versioned in the
# internal companion repo; the tracked .example documents its shape.
# (Internal git config lives in ~/.gitconfig.local, outside this repo — see
# the note at the foot of config/git/gitconfig.)
config/sway/outputs.conf

# Editor configs
.vscode/
.idea/
*.code-workspace

# dfinstall runtime config (example file is tracked)
.config.yaml

# Neovim plugin lock (auto-updated by lazy.nvim)
config/nvim/lazy-lock.json

# Python bytecode (config/sway/sway-quickpanel is a .py-less script, but
# `python3 -m py_compile` on it drops a __pycache__ beside it)
__pycache__/
*.pyc

# Go
*.exe
*.test
*.out

# Compiled binaries built outside bin/ (make build targets bin/)
/dfinstall
/dfinstall-mcp
