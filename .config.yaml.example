# dfinstall configuration
# Auto-generated after first install run.
# Lives at ~/.config/dfinstall/config.yaml ($XDG_CONFIG_HOME/dfinstall/config.yaml)

# Skip automatic backups on install (set to false to backup every time)
skip_backup: true

# Custom backup directory (default: ~/.local/share/dfinstall/backups)
# backup_dir: /path/to/backups

# Extended OMZ plugins (selected via dfinstall install omz --extended)
# extended_plugins:
#   - kubectl
#   - aws
#   - sudo

# Skip specific modules during 'install all' / 'update all'
# skip_modules:
#   - wsl
#   - fonts

# Shell files preserved when the shell module replaces ~/.zshrc
# (managed automatically via interactive prompt on first install)
# preserved_files:
#   - .companyrc
#   - .work_env

# Shell files the user chose NOT to preserve (won't be prompted again)
# dismissed_files:
#   - .old_aliases

# Toolkit tools to keep installed (selected via dfinstall install --toolkit).
# Managed automatically via the interactive menu; names come from the registry.
# toolkit_tools:
#   - nmap
#   - ffuf

# Override the toolkit registry location (default: the sresarehumantoo
# dotfiles-toolkit registry). Accepts an HTTP(S) URL, file:// URL, or path.
# Also settable per-run with --registry.
# toolkit_registry_url: https://example.com/registry.json

# Opt-in for the windev module (Windows cross-development toolchains + nvim
# language support + winbuild remote-dispatch helper). Set automatically by
# `dfinstall install windev`; cleared by `dfinstall uninstall windev`. While
# false, the module is skipped by `install all`.
# windev_enabled: false

# Opt-in for the opencode module (opencode for Anthropic API / Bedrock users).
# Set by `dfinstall install opencode`; cleared by `dfinstall uninstall
# opencode`. While false, the module is skipped by `install all`.
# opencode_enabled: false

# Offline doc sets fetched by the docs module and read with `docs SET TOPIC`.
# Each is a DevDocs slug (https://devdocs.io/docs.json): a bare name such as
# "python" takes the newest version, "python~3.13" pins one. "gitlab" is the
# markdown from GitLab's own repo, about 45 MB, so it is not a default. Sets
# dropped from the list are deleted on the next install. Unset means the
# defaults below; skip the module entirely with skip_modules: [docs].
# doc_sets: [python, bash, git, go, docker, kubernetes, node]
