{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.local/bin/claude-no-attribution\" ] || \"$HOME/.local/bin/claude-no-attribution\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.local/bin/claude-tmux\" ] || \"$HOME/.local/bin/claude-tmux\" record"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.local/bin/claude-tmux\" ] || \"$HOME/.local/bin/claude-tmux\" end"
          }
        ]
      }
    ]
  }
}
