# Security research feeds, tagged by category. Tag names match the FreshRSS
# categories, so the query feeds below also work when config.local switches
# urls-source to a FreshRSS server (feed lines are then ignored).

"query:Exploited in the wild:title =~ \"(0-day|zero-day|0day|actively exploited|in the wild|KEV)\""
"query:CVEs:title =~ \"CVE-[0-9]{4}-[0-9]+\""
"query:Unread:unread = \"yes\""
"query:Starred:flags # \"s\""

