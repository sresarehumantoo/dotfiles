+	/// LOCAL DELTA: animate the window's opacity towards `to`, optionally
+	/// hiding it once it arrives. Upstream maps and unmaps the layer-shell
+	/// surface outright, so the overlay pops in and out; there is no fade,
+	/// transition or opacity anywhere in the widget.
+	///
+	/// A tick callback rather than a timer: it is driven by the frame clock, so
+	/// it runs at the monitor's refresh rate and stops cleanly when the surface
+	/// is not being drawn. Any in-flight fade is cancelled first, which is what
+	/// makes a key pressed during the fade-out snap back to full instead of
+	/// racing two animations.
+	fn fade(&self, to: f64, hide_after: bool) {
+		if let Some(id) = self.fade_id.take() {
+			id.remove();
+		}
+
+		let from = self.window.opacity();
+		if (from - to).abs() < 0.001 {
+			if hide_after {
+				self.window.hide();
+			}
+			return;
+		}
+
+		let start = match self.window.frame_clock() {
+			Some(clock) => clock.frame_time(),
+			// Not realised yet, so there is no clock to drive an animation.
+			None => {
+				self.window.set_opacity(to);
+				if hide_after {
+					self.window.hide();
+				}
+				return;
+			}
+		};
+
+		let id = self.window.add_tick_callback(clone!(
+			#[strong(rename_to = fade_id)]
+			self.fade_id,
+			move |win, clock| {
+				// frame_time() is microseconds.
+				let elapsed = (clock.frame_time() - start) as f64 / 1000.0;
+				let t = (elapsed / FADE_MS).clamp(0.0, 1.0);
+				win.set_opacity(from + (to - from) * t);
+
+				if t >= 1.0 {
+					if hide_after {
+						win.hide();
+					}
+					fade_id.replace(None);
+					return glib::ControlFlow::Break;
+				}
+				glib::ControlFlow::Continue
+			}
+		));
+		self.fade_id.replace(Some(id));
+	}
