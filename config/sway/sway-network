def sync_children(container, keys, factory):
    """Reconcile `container` to exactly `keys`, in order, reusing widgets.

    WARNING: THE OBVIOUS ALTERNATIVE -- EMPTY THE BOX AND REBUILD IT ON EVERY
    REFRESH -- IS WRONG HERE, AND NOT ONLY UNTIDY. The panel refreshes on a 2 s
    tick and on every NetworkManager signal, so a rebuild would destroy an open
    password field and its contents while somebody was typing into it, and drop
    keyboard focus and the hover highlight several times a minute. Widgets are
    therefore created once per key and only reordered.
    """
    existing = {}
    for child in container.get_children():
        key = getattr(child, "sync_key", None)
        if key in keys and key not in existing:
            existing[key] = child
        else:
            child.destroy()
    out = {}
    for index, key in enumerate(keys):
        widget = existing.get(key)
        if widget is None:
            widget = factory(key)
            widget.sync_key = key
            container.pack_start(widget, False, False, 0)
        container.reorder_child(widget, index)
        out[key] = widget
    return out


class SignalIcon(Gtk.DrawingArea):
    """Signal strength as three arcs and a dot, drawn rather than set in a font.

    ⚠ THIS REPLACED THE FONT RAMP BECAUSE THE FONT RAMP CANNOT BE COUNTED, and
    that was established by rendering both rather than by argument. The four
    `md-wifi_strength_*` glyphs are one cone with a lens cut out of the top, and
    the only thing that changes between levels is how high the fill reaches
    inside it. Measured off the real panel at the size it actually draws:

        level 1 -> 64 px of ink   level 2 -> 75 px   level 3 -> 92 px

    so 1 and 2 differ by eleven pixels of fill height, and at a glance a list of
    them reads as one repeated glyph. Growing the icon does not help -- the step
    stays ~20-23% of the ink at every size, because it is a property of the
    shapes.

    What Windows 11, macOS and GNOME all do instead is draw the UNLIT part of
    the ramp as a visible ghost, so the reader sees four slots and counts how
    many are filled. That is a discrete, countable cue rather than a judgement
    about an area, and it is what this draws.

    ⚠ THE BAR STILL USES THE FONT RAMP, AND THAT IS DELIBERATE. waybar cannot
    draw, and the two surfaces are answering different questions: the bar shows
    ONE network, where "roughly how strong" is all a glyph needs to say, while a
    list exists to be compared down. Keeping the font ramp in a list was the
    original call here and it was wrong; keeping it in the bar is not.

    The color comes from the style context, so `label.rowicon`'s CSS still
    governs it and the theme stays in one place.
    """

    __gtype_name__ = "SwayNetworkSignalIcon"

    SIZE = 18

    def __init__(self):
        super().__init__()
        self.level = 0
        self.set_size_request(self.SIZE, self.SIZE)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self._on_draw)

    def set_level(self, level):
        level = max(0, min(3, int(level)))
        if level != self.level:
            self.level = level
            self.queue_draw()

    def _on_draw(self, _w, cr):
        import math
        ctx = self.get_style_context()
        rgba = ctx.get_color(ctx.get_state())
        size = self.SIZE
        cx = size / 2.0
        cy = size * 0.80          # apex of the fan, near the bottom
        lw = max(1.0, size * 0.095)
        dim = 0.22                # the unlit ghost: present, clearly not lit
        cr.set_line_cap(1)        # cairo.LINE_CAP_ROUND, without the import
        cr.arc(cx, cy - lw * 0.15, lw * 0.62, 0, 2 * math.pi)
        cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, rgba.alpha)
        cr.fill()
        for i in range(3):
            radius = size * (0.20 + 0.145 * i)
            lit = self.level >= i + 1
            cr.set_source_rgba(rgba.red, rgba.green, rgba.blue,
                               rgba.alpha if lit else rgba.alpha * dim)
            cr.set_line_width(lw)
            cr.arc(cx, cy, radius, math.radians(-135), math.radians(-45))
            cr.stroke()
        return False


class Row(Gtk.Box):
    """A clickable line, plus a revealer holding its actions.

    One row is one SSID (or one device, or one VPN profile). The revealer is
    collapsed unless this row is the panel's expanded one.
    """

    def __init__(self, panel, key):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.panel = panel
        self.key = key

        self.button = Gtk.Button()
        self.button.get_style_context().add_class("row")
        # BUTTON_PRESS on the button itself, not on the window: the window-level
        # handler exists to catch clicks OUTSIDE the panel and must not have to
        # work out which row was hit.
        self.button.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.button.connect("button-press-event", self._on_press)
        self.button.connect("clicked", lambda _b: self.panel.on_row_activate(self))

        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        # TWO icons, one shown at a time. Wifi rows get the drawn ramp (see
        # SignalIcon); wired and VPN rows get a glyph, where there is no level
        # to show and the font is the right tool.
        self.signal = SignalIcon()
        self.signal.get_style_context().add_class("rowicon")
        self.icon = Gtk.Label()
        self.icon.get_style_context().add_class("rowicon")
        self.name = Gtk.Label(xalign=0.0)
        self.name.get_style_context().add_class("rowname")
        self.name.set_ellipsize(Pango.EllipsizeMode.END)
        self.meta = Gtk.Label(xalign=1.0)
        self.meta.get_style_context().add_class("rowmeta")
        self.lock = Gtk.Label()
        self.lock.get_style_context().add_class("rowlock")
        # A spinner, not just the word "Connecting". Every one of the three
        # desktops this panel is modelled on shows motion on the row you acted
        # on -- it is the difference between "it heard me" and "did that work?"
        self.spinner = Gtk.Spinner()
        self.spinner.set_valign(Gtk.Align.CENTER)
        line.pack_start(self.signal, False, False, 0)
        line.pack_start(self.icon, False, False, 0)
        line.pack_start(self.name, True, True, 0)
        line.pack_end(self.lock, False, False, 0)
        line.pack_end(self.meta, False, False, 0)
        line.pack_end(self.spinner, False, False, 0)
        self.button.add(line)
        self.pack_start(self.button, False, False, 0)

        self.revealer = Gtk.Revealer()
        self.revealer.set_transition_type(
            Gtk.RevealerTransitionType.SLIDE_DOWN)
        self.revealer.set_transition_duration(140)
        self.actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.actions.get_style_context().add_class("actions")
        self.revealer.add(self.actions)
        self.pack_start(self.revealer, False, False, 0)

        self.detail = Gtk.Label(xalign=0.0)
        self.detail.get_style_context().add_class("detail")
        self.detail.set_line_wrap(True)
        self.actions.pack_start(self.detail, False, False, 0)

        self.entry_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.entry = Gtk.Entry()
        self.entry.get_style_context().add_class("psk")
        self.entry.set_visibility(False)
        self.entry.set_placeholder_text("Password")
        self.entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.entry.connect("activate", lambda _e: self.panel.on_connect(self))
        self.eye = Gtk.Button(label=ICON_EYE)
        self.eye.get_style_context().add_class("reveal")
        self.eye.connect("clicked", self._toggle_visibility)
        self.entry_box.pack_start(self.entry, True, True, 0)
        self.entry_box.pack_start(self.eye, False, False, 0)
        self.actions.pack_start(self.entry_box, False, False, 0)

        self.buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.actions.pack_start(self.buttons, False, False, 0)
        self.show_all()
        # ⚠ Marked AFTER show_all, or show_all would un-hide them again. Each of
        # these is shown only in the states that want it.
        for widget in (self.entry_box, self.signal, self.icon, self.spinner):
            widget.set_no_show_all(True)
        self.entry_box.hide()
        self.spinner.hide()

    def set_busy(self, busy):
        self.spinner.set_visible(busy)
        if busy:
            self.spinner.start()
        else:
            self.spinner.stop()

    def show_signal(self, level):
        self.icon.hide()
        self.signal.set_level(level)
        self.signal.show()

    def show_glyph(self, glyph):
        self.signal.hide()
        self.icon.set_text(glyph)
        self.icon.show()

    def _toggle_visibility(self, _b):
        shown = not self.entry.get_visibility()
        self.entry.set_visibility(shown)
        self.eye.set_label(ICON_EYE_OFF if shown else ICON_EYE)

    def _on_press(self, _w, event):
        # Right-click always opens the row rather than acting on it: that is how
        # Forget stays reachable on a saved network without putting an extra
        # click in front of the ordinary "click the network I want" path. See
        # Panel.on_row_activate.
        dbg("row press b%d on %r", event.button, self.key)
        if event.button == 3:
            self.panel.set_expanded(None if self.panel.expanded == self.key
                                    else self.key)
            return True
        return False

    def set_actions(self, specs):
        """specs: [(label, css_class, callback)] -- rebuilt only when changed."""
        sig = tuple((label, cls) for label, cls, _cb in specs)
        if getattr(self, "_action_sig", None) == sig:
            # Refresh the callbacks; they close over snapshot data that moved.
            for button, (_l, _c, cb) in zip(self.buttons.get_children(), specs):
                if getattr(button, "_handler", None):
                    button.disconnect(button._handler)
                button._handler = button.connect("clicked", lambda _b, f=cb: f())
            return
        self._action_sig = sig
        for child in self.buttons.get_children():
            child.destroy()
        for label, cls, cb in specs:
            button = Gtk.Button(label=label)
            ctx = button.get_style_context()
            ctx.add_class("act")
            if cls:
                ctx.add_class(cls)
            button._handler = button.connect("clicked", lambda _b, f=cb: f())
            self.buttons.pack_start(button, False, False, 0)
        self.buttons.show_all()


