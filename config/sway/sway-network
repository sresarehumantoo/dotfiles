class Panel(Gtk.Window):
    def __init__(self, nm, anchor="right"):
        super().__init__(title="Network")
        self.nm = nm
        self.anchor = anchor
        self.snap = None
        self.expanded = None      # key of the one open row, or None
        self.busy = None          # (key, message) while an action is in flight
        self.error = None
        self._focus_armed = False
        self._tick = 0
        self._rescan = 0
        self._coalesce = 0
        self._scan_asked = -1
        self.set_resizable(False)

        # The surface covers the whole usable area so a click outside the panel
        # reaches us and can dismiss it, so the OFFSETS live on this box rather
        # than on the layer surface. See the layer-shell setup in main().
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.get_style_context().add_class("panel")
        root.set_valign(Gtk.Align.START)
        root.set_size_request(PANEL_WIDTH, -1)
        root.set_margin_top(GAP)
        if anchor == "left":
            root.set_halign(Gtk.Align.START)
            root.set_margin_start(EDGE_MARGIN)
        elif anchor == "center":
            root.set_halign(Gtk.Align.CENTER)
        else:
            root.set_halign(Gtk.Align.END)
            root.set_margin_end(EDGE_MARGIN)
        self.panel = root
        self.add(root)

        # -- header ----------------------------------------------------------
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.get_style_context().add_class("header")
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        title = Gtk.Label(label="Wi-Fi", xalign=0.0)
        title.get_style_context().add_class("title")
        self.subtitle = Gtk.Label(xalign=0.0)
        self.subtitle.get_style_context().add_class("subtitle")
        self.subtitle.set_ellipsize(Pango.EllipsizeMode.END)
        titles.pack_start(title, False, False, 0)
        titles.pack_start(self.subtitle, False, False, 0)
        self.switch = Gtk.Switch()
        self.switch.set_valign(Gtk.Align.CENTER)
        self._switch_handler = self.switch.connect("notify::active",
                                                   self._on_switch)
        header.pack_start(titles, True, True, 0)
        header.pack_end(self.switch, False, False, 0)
        root.pack_start(header, False, False, 0)

        # -- wifi list -------------------------------------------------------
        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroller.set_propagate_natural_height(True)
        self.scroller.set_max_content_height(LIST_MAX_HEIGHT)
        self.wifi_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        self.scroller.add(self.wifi_box)
        root.pack_start(self.scroller, False, False, 0)

        self.placeholder = Gtk.Label(xalign=0.0)
        self.placeholder.get_style_context().add_class("section")
        root.pack_start(self.placeholder, False, False, 0)

        # -- wired and VPN ---------------------------------------------------
        self.eth_heading, self.eth_box = self._section(root, "WIRED")
        self.vpn_heading, self.vpn_box = self._section(root, "VPN")

        # -- footer ----------------------------------------------------------
        rule = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        rule.get_style_context().add_class("rule")
        root.pack_start(rule, False, False, 0)
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        footer.get_style_context().add_class("footer")
        self.status = Gtk.Label(xalign=0.0)
        self.status.get_style_context().add_class("status")
        self.status.set_ellipsize(Pango.EllipsizeMode.END)
        settings = Gtk.Button(label=ICON_COG + "  Settings")
        settings.get_style_context().add_class("settings")
        settings.connect("clicked", self._open_settings)
        footer.pack_start(self.status, True, True, 0)
        footer.pack_end(settings, False, False, 0)
        root.pack_start(footer, False, False, 0)

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self._on_button_press)
        self.connect("key-press-event", self._on_key)
        self.connect("focus-out-event", self._on_focus_out)
        self.connect("destroy", Gtk.main_quit)

        # WARNING: show_all() UN-HIDES EVERYTHING, INCLUDING WIDGETS THIS PANEL
        # HIDES ON PURPOSE -- an empty VPN section, a password field on a row
        # that needs none. Every such widget is marked no_show_all, and it is
        # marked HERE, after the single show_all below, so the tree is realized
        # once and later opens use show() rather than show_all().
        self.show_all()
        for widget in (self.placeholder, self.eth_heading, self.eth_box,
                       self.vpn_heading, self.vpn_box):
            widget.set_no_show_all(True)
        self.hide()

    def _section(self, root, label):
        heading = Gtk.Label(label=label, xalign=0.0)
        heading.get_style_context().add_class("section")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        root.pack_start(heading, False, False, 0)
        root.pack_start(box, False, False, 0)
        return heading, box

    # -- lifecycle -----------------------------------------------------------
    def toggle_visible(self):
        if self.get_visible():
            self.hide_panel()
        else:
            self.show_panel()

    def show_panel(self):
        self.error = None
        self.busy = None
        self.set_expanded(None)
        # Saved profiles are cached (see NetworkManager.reload_saved) and can
        # have been edited from nm-connection-editor since the last open.
        self.nm.reload_saved()
        self.refresh()
        # Re-arm the focus guard on EVERY open, not just the first: the spurious
        # post-map focus-in/focus-out pair happens on every map, so a flag left
        # armed from the previous showing dismisses this one instantly.
        self._focus_armed = False
        GLib.timeout_add(FOCUS_ARM_MS, self._arm_focus_close)
        self.show()
        # Live updates cost nothing while the panel is closed: the
        # subscriptions and both timers exist only between show and hide.
        self.nm.subscribe(self._on_nm_signal)
        self._tick = GLib.timeout_add(TICK_MS, self._on_tick)
        self._rescan = GLib.timeout_add(RESCAN_MS, self._on_rescan)
        self._do_scan()

    def hide_panel(self):
        self.hide()
        self.nm.unsubscribe()
        for attr in ("_tick", "_rescan", "_coalesce"):
            source = getattr(self, attr)
            if source:
                GLib.source_remove(source)
                setattr(self, attr, 0)

    def _on_tick(self):
        self.refresh()
        return True

    def _on_rescan(self):
        self._do_scan()
        return True

    def _do_scan(self):
        if self.snap and not self.snap["wireless_enabled"]:
            return
        self._scan_asked = boottime_ms()
        self.nm.request_scan()

    def _on_nm_signal(self, member):
        if member in ("NewConnection", "ConnectionRemoved"):
            self.nm.reload_saved()
        # Coalesce: a single scan completing emits a PropertiesChanged per
        # access point, so an un-debounced handler would redraw the list dozens
        # of times in the same millisecond.
        if self._coalesce:
            return
        self._coalesce = GLib.timeout_add(COALESCE_MS, self._coalesced)

    def _coalesced(self):
        self._coalesce = 0
        self.refresh()
        return False

    # -- focus and dismissal -------------------------------------------------
    def _arm_focus_close(self):
        self._focus_armed = True
        return False

    def _on_focus_out(self, *_a):
        dbg("focus-out armed=%s visible=%s", self._focus_armed, self.get_visible())
        if self._focus_armed and self.get_visible():
            self.hide_panel()
        return False

    def _on_button_press(self, _w, event):
        """Dismiss on a click outside the panel box.

        Tested against the panel's ALLOCATION, not by asking whether a child
        handled the click: the panel's own padding is not a child widget (a
        Gtk.Box has no event window), so a click on the 6px border arrives here
        exactly like a click on the wallpaper.
        """
        alloc = self.panel.get_allocation()
        inside = (alloc.x <= event.x < alloc.x + alloc.width
                  and alloc.y <= event.y < alloc.y + alloc.height)
        dbg("window press b%d at (%.0f,%.0f) panel=(%d,%d %dx%d) inside=%s",
            event.button, event.x, event.y,
            alloc.x, alloc.y, alloc.width, alloc.height, inside)
        if not inside:
            self.hide_panel()
            return True
        return False

    def _on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            # Escape backs out one level: an open row first, then the panel.
            # HIDE, never quit -- this process is the resident server, and
            # quitting would throw away the window that makes the next click
            # instant.
            if self.expanded is not None:
                self.set_expanded(None)
            else:
                self.hide_panel()
            return True
        return False

    # -- rendering -----------------------------------------------------------
    def refresh(self):
        snap = self.nm.snapshot()
        self.snap = snap

        # Blocked while set programmatically, or reflecting NM's state back into
        # the widget would immediately look like the user had flipped it.
        self.switch.handler_block(self._switch_handler)
        self.switch.set_active(snap["wireless_enabled"])
        self.switch.handler_unblock(self._switch_handler)
        self.switch.set_sensitive(
            snap["ok"] and snap["wireless_hw"] and snap["wifi_dev"] is not None)

        if snap["active_ssid"] and snap["active_state"] == ACT_ACTIVATED:
            wifi_dev = snap["wifi_dev"] or {}
            self.subtitle.set_text(
                "  ·  ".join(x for x in (snap["active_ssid"],
                                        (wifi_dev.get("ip") or "").split("/")[0])
                            if x))
        elif not snap["wireless_hw"]:
            self.subtitle.set_text("Blocked by the hardware switch")
        elif not snap["wireless_enabled"]:
            self.subtitle.set_text("Off")
        else:
            self.subtitle.set_text("Not connected")

        self._render_wifi(snap)
        self._render_eth(snap)
        self._render_vpn(snap)
        self._render_footer(snap)

    def _render_wifi(self, snap):
        if not snap["ok"] or snap["wifi_dev"] is None or not snap["wireless_enabled"]:
            self.scroller.hide()
            self.placeholder.set_text(
                "NetworkManager is not responding" if not snap["ok"] else
                "No Wi-Fi hardware" if snap["wifi_dev"] is None else
                "Wi-Fi is off")
            self.placeholder.show()
            return
        self.placeholder.hide()
        self.scroller.show()

        aps = list(snap["aps"])
        # KEEP THE OPEN ROW EVEN IF ITS NETWORK DROPS OUT OF THE SCAN. A weak AP
        # comes and goes between scans, and without this the row you are typing
        # a password into is destroyed underneath you mid-word.
        seen = {ap["ssid_raw"] for ap in aps}
        remembered = getattr(self, "_ap_cache", {})
        if isinstance(self.expanded, bytes) and self.expanded not in seen:
            stale = remembered.get(self.expanded)
            if stale:
                stale = dict(stale, strength=0, is_active=False)
                aps.append(stale)
        self._ap_cache = {ap["ssid_raw"]: ap for ap in aps}

        rows = sync_children(self.wifi_box, [ap["ssid_raw"] for ap in aps],
                             lambda key: Row(self, key))
        for ap in aps:
            self._update_wifi_row(rows[ap["ssid_raw"]], ap, snap)

    def _update_wifi_row(self, row, ap, snap):
        row.data = {"kind": "wifi", "ap": ap}
        kind, label = ap["security"]
        secured = kind not in ("open", "owe")
        saved = bool(ap["saved"])
        connected = ap["is_active"] and snap["active_state"] == ACT_ACTIVATED
        connecting = ap["is_active"] and not connected

        row.icon.set_text(wifi_icon(ap["strength"]))
        row.name.set_text(ap["ssid"])
        row.lock.set_text(ICON_LOCK if secured else "")
        if self.busy and self.busy[0] == ap["ssid_raw"]:
            row.meta.set_text(self.busy[1])
        elif connected:
            row.meta.set_text("Connected")
        elif connecting:
            row.meta.set_text("Connecting")
        elif saved:
            row.meta.set_text("Saved")
        else:
            row.meta.set_text("")
        ctx = row.button.get_style_context()
        (ctx.add_class if ap["is_active"] else ctx.remove_class)("active")

        bits = [label, band_label(ap["freq"]), "%d%%" % ap["strength"]]
        if connected:
            wifi_dev = snap["wifi_dev"] or {}
            if wifi_dev.get("ip"):
                bits.append(wifi_dev["ip"])
            if wifi_dev.get("bitrate"):
                bits.append("%d Mb/s" % (wifi_dev["bitrate"] // 1000))
        row.detail.set_text("  ·  ".join(b for b in bits if b))

        need_psk = secured and not saved and kind != "enterprise"
        row.entry_box.set_visible(need_psk)
        if not need_psk:
            row.entry.set_text("")

        actions = []
        if kind == "enterprise" and not saved:
            # 802.1X needs an identity, a method, sometimes a certificate. That
            # is a form, not a password box, and nm-applet is already this
            # session's secret agent for it -- so hand off rather than build a
            # worse version of nm-connection-editor's.
            row.detail.set_text(row.detail.get_text()
                                + "\n" + label + " needs a full profile.")
            actions.append(("Set up…", None, self._open_settings))
        elif connected or connecting:
            actions.append(("Disconnect", "danger", lambda: self._disconnect_wifi()))
        else:
            actions.append(("Connect", None, lambda r=row: self.on_connect(r)))
        if saved:
            actions.append(("Forget", "danger", lambda a=ap: self._forget(a)))
        row.set_actions(actions)
        row.revealer.set_reveal_child(self.expanded == ap["ssid_raw"])

    def _render_eth(self, snap):
        devices = snap["ethernet"]
        self.eth_heading.set_visible(bool(devices))
        self.eth_box.set_visible(bool(devices))
        if not devices:
            return
        rows = sync_children(self.eth_box, [d["path"] for d in devices],
                             lambda key: Row(self, key))
        for dev in devices:
            row = rows[dev["path"]]
            row.data = {"kind": "eth", "dev": dev}
            up = dev["state"] == DEV_STATE_ACTIVATED
            row.icon.set_text(ICON_ETHERNET)
            row.name.set_text(dev["active"]["id"] if dev["active"] else dev["iface"])
            row.lock.set_text("")
            row.meta.set_text("Connected" if up else
                              "Unplugged" if dev["state"] <= DEV_STATE_UNAVAILABLE
                              else "Available")
            ctx = row.button.get_style_context()
            (ctx.add_class if up else ctx.remove_class)("active")
            row.entry_box.hide()
            row.detail.set_text("  ·  ".join(
                b for b in (dev["iface"], dev["ip"]) if b))
            if up:
                row.set_actions([("Disconnect", "danger",
                                  lambda d=dev: self._disconnect_device(d))])
            elif dev["available"]:
                row.set_actions([("Connect", None,
                                  lambda d=dev: self._connect_eth(d))])
            else:
                row.set_actions([])
            row.revealer.set_reveal_child(self.expanded == dev["path"])

    def _render_vpn(self, snap):
        entries = snap["vpn"]
        self.vpn_heading.set_visible(bool(entries))
        self.vpn_box.set_visible(bool(entries))
        if not entries:
            return
        keys = [e.get("path", "ext:" + e["id"]) for e in entries]
        rows = sync_children(self.vpn_box, keys, lambda key: Row(self, key))
        for key, entry in zip(keys, entries):
            row = rows[key]
            row.data = {"kind": "vpn", "entry": entry}
            up = entry["state"] == ACT_ACTIVATED
            external = entry["kind"] == "external"
            row.icon.set_text(ICON_VPN)
            row.name.set_text(entry["id"])
            row.lock.set_text("")
            row.entry_box.hide()
            ctx = row.button.get_style_context()
            (ctx.add_class if up else ctx.remove_class)("active")
            (ctx.add_class if external else ctx.remove_class)("readonly")
            if external:
                # Not ours to switch off -- see the DEV_TUN branch of snapshot().
                row.meta.set_text("Up (external)")
                row.detail.set_text("  ·  ".join(
                    b for b in (entry.get("iface", ""), entry.get("ip") or "") if b))
                row.set_actions([])
            else:
                row.meta.set_text("Connected" if up else
                                  "Connecting" if entry["state"] == ACT_ACTIVATING
                                  else "Off")
                row.detail.set_text(entry["type"])
                row.set_actions([("Disconnect", "danger",
                                  lambda e=entry: self._vpn_down(e))] if up else
                                [("Connect", None, lambda e=entry: self._vpn_up(e))])
            row.revealer.set_reveal_child(self.expanded == key)

    def _render_footer(self, snap):
        ctx = self.status.get_style_context()
        ctx.remove_class("error")
        if not snap["ok"]:
            self.status.set_text("NetworkManager is not responding")
            ctx.add_class("error")
        elif self.error:
            self.status.set_text(self.error)
            ctx.add_class("error")
        elif self.busy:
            self.status.set_text(self.busy[1])
        elif not snap["wireless_enabled"]:
            self.status.set_text("Wi-Fi is off")
        elif self._scanning(snap):
            self.status.set_text("Scanning…")
        else:
            count = len(snap["aps"])
            self.status.set_text("%d network%s" % (count, "" if count == 1 else "s"))

    def _scanning(self, snap):
        """True between asking for a scan and NM reporting one finished.

        NM sets LastScan when a scan COMPLETES, so "scanning" is the window
        between our request and that timestamp moving past it. Both are
        CLOCK_BOOTTIME -- see boottime_ms for why that matters.
        """
        if self._scan_asked < 0:
            return False
        if snap["last_scan"] >= self._scan_asked:
            return False
        return boottime_ms() - self._scan_asked < 8000

    # -- interaction ---------------------------------------------------------
    def set_expanded(self, key):
        self.expanded = key
        for box in (self.wifi_box, self.eth_box, self.vpn_box):
            for row in box.get_children():
                row.revealer.set_reveal_child(row.sync_key == key)
                if row.sync_key == key and row.entry_box.get_visible():
                    row.entry.grab_focus()

    def on_row_activate(self, row):
        """A LEFT-CLICK CONNECTS; IT DOES NOT MERELY OPEN THE ROW.

        Expanding first would put a second click in front of the only thing
        anybody opens this panel to do. So the row opens only when it has
        something to ask (a password) or something to show (you are already on
        this network, here is Disconnect). Everything else -- a saved profile,
        an open network -- joins on the one click.

        Forget therefore needs another route, and that is the right-click in
        Row._on_press, which always opens the row whatever its state.
        """
        if self.expanded == row.sync_key:
            self.set_expanded(None)
            return
        data = getattr(row, "data", None)
        if not data:
            return
        if data["kind"] == "wifi":
            ap = data["ap"]
            if ap["is_active"] or ap["security"][0] == "enterprise":
                self.set_expanded(row.sync_key)
            elif ap["saved"]:
                self._connect_saved(ap)
            elif ap["security"][0] in ("open", "owe"):
                self._connect_new(ap, None)
            else:
                self.set_expanded(row.sync_key)
        elif data["kind"] == "eth":
            dev = data["dev"]
            if dev["state"] == DEV_STATE_ACTIVATED or not dev["available"]:
                self.set_expanded(row.sync_key)
            else:
                self._connect_eth(dev)
        elif data["kind"] == "vpn":
            entry = data["entry"]
            if entry["kind"] == "external":
                self.set_expanded(row.sync_key)
            elif entry["state"] == ACT_ACTIVATED:
                self._vpn_down(entry)
            else:
                self._vpn_up(entry)

    def on_connect(self, row):
        data = getattr(row, "data", None)
        if not data or data["kind"] != "wifi":
            return
        ap = data["ap"]
        psk = row.entry.get_text() if row.entry_box.get_visible() else ""
        if ap["saved"] and not psk:
            self._connect_saved(ap)
        else:
            self._connect_new(ap, psk or None)

    def _on_switch(self, switch, _param):
        self.error = None
        self.nm.set_wireless_enabled(switch.get_active(), self._done)

    def _open_settings(self, *_a):
        self.hide_panel()
        # Detached, and explicitly NOT through a shell: the panel must not
        # outlive its child's stdout or keep a zombie around.
        try:
            Gio.Subprocess.new(["nm-connection-editor"],
                               Gio.SubprocessFlags.STDOUT_SILENCE
                               | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as e:
            self.error = friendly_error(e.message)

    # -- actions -------------------------------------------------------------
    def _begin(self, key, message):
        self.busy = (key, message)
        self.error = None
        self.refresh()

    def _done(self, err):
        self.busy = None
        self.error = friendly_error(err) if err else None
        if not err:
            self.set_expanded(None)
        self.refresh()

    def _wifi_dev(self):
        dev = (self.snap or {}).get("wifi_dev")
        return dev["path"] if dev else None

    def _connect_saved(self, ap):
        dev = self._wifi_dev()
        if not dev:
            return
        self._begin(ap["ssid_raw"], "Connecting to %s" % ap["ssid"])
        self.nm.activate(ap["saved"][0]["path"], dev, ap["path"], self._done)

    def _connect_new(self, ap, psk):
        """Create a profile and bring it up, with the key sent over the bus.

        The alternative -- shelling out to `nmcli device wifi connect SSID
        password ...` -- publishes the PSK in /proc/<pid>/cmdline for the life
        of the process, where any local process can read it.
        """
        dev = self._wifi_dev()
        if not dev:
            return
        kind = ap["security"][0]
        settings = {
            "connection": {
                "id": GLib.Variant("s", ap["ssid"]),
                "type": GLib.Variant("s", "802-11-wireless"),
            },
            "802-11-wireless": {
                # THE RAW OCTETS, NOT THE DISPLAY STRING. An SSID is 32
                # arbitrary bytes; re-encoding what ssid_str decoded would send
                # U+FFFD to the router for any SSID that is not valid UTF-8.
                "ssid": GLib.Variant("ay", ap["ssid_raw"]),
                "mode": GLib.Variant("s", "infrastructure"),
            },
        }
        if psk:
            # SAE is preferred where the AP offers both: NM negotiates down on
            # its own, whereas asking for wpa-psk against a WPA3-only AP fails.
            settings["802-11-wireless-security"] = {
                "key-mgmt": GLib.Variant("s", "sae" if kind == "sae" else "wpa-psk"),
                "psk": GLib.Variant("s", psk),
            }
        self._begin(ap["ssid_raw"], "Connecting to %s" % ap["ssid"])
        self.nm.add_and_activate(settings, dev, ap["path"], self._done)

    def _disconnect_wifi(self):
        dev = self._wifi_dev()
        if not dev:
            return
        # Device.Disconnect, not DeactivateConnection: it also stops the device
        # autoconnecting straight back to what you just left, which is the whole
        # point of pressing Disconnect.
        self._begin(None, "Disconnecting")
        self.nm.disconnect_device(dev, self._done)

    def _disconnect_device(self, dev):
        self._begin(None, "Disconnecting")
        self.nm.disconnect_device(dev["path"], self._done)

    def _connect_eth(self, dev):
        self._begin(None, "Connecting")
        self.nm.activate(dev["available"][0], dev["path"], "/", self._done)

    def _forget(self, ap):
        """Delete EVERY saved profile for this SSID, not just the first.

        One SSID can carry several, and this box has a live pair --
        'FoodArt-5GHz' and 'FoodArt-5GHz 1'. Deleting one would leave the other
        to autoconnect, so the network would look forgotten and then come back.
        """
        remaining = [c["path"] for c in ap["saved"]]
        if not remaining:
            return
        self._begin(ap["ssid_raw"], "Forgetting %s" % ap["ssid"])
        state = {"left": len(remaining), "err": None}

        def one_done(err):
            state["left"] -= 1
            state["err"] = state["err"] or err
            if state["left"] == 0:
                self.nm.reload_saved()
                self._done(state["err"])

        for path in remaining:
            self.nm.delete_connection(path, one_done)

    def _vpn_up(self, entry):
        self._begin(None, "Connecting to %s" % entry["id"])
        self.nm.activate(entry["path"], "/", "/", self._done)

    def _vpn_down(self, entry):
        active = entry.get("active")
        if not active:
            return
        self._begin(None, "Disconnecting %s" % entry["id"])
        self.nm.deactivate(active["path"], self._done)


def friendly_error(message):
    """Strip the D-Bus decoration off an NM error.

    A raw one reads 'GDBus.Error:org.freedesktop.NetworkManager.Device.
    InvalidConnection: 802-11-wireless-security.psk: property is invalid',
    which is three quarters namespace. The footer has one line.
    """
    if not message:
        return None
    text = message.split(": ", 1)[-1].strip()
    text = text.replace("802-11-wireless-security.psk", "password")
    if len(text) > 78:
        text = text[:77] + "…"
    return text or "Failed"


def main():
    args = sys.argv[1:]

    anchor = "right"
    if "--anchor" in args:
        i = args.index("--anchor")
        if i + 1 >= len(args) or args[i + 1] not in ("left", "center", "right"):
            print("--anchor takes one of: left, center, right", file=sys.stderr)
            return 2
        anchor = args[i + 1]

    # Reaching main() means client_fast_path declined this invocation, so we are
    # becoming the resident server. Two ways in: `--server` (autostarted from
    # config/sway/config, come up hidden) or a click that found no server (become
    # one AND show, or the click would appear to do nothing).
    show_now = "--server" not in args

    GLib.set_prgname(APP_ID)

    try:
        nm = NetworkManager()
    except GLib.Error as e:
        print("cannot reach NetworkManager on the system bus: %s" % e.message,
              file=sys.stderr)
        return 1

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win = Panel(nm, anchor=anchor)

    # init_for_window MUST precede the first map -- it is what makes this a
    # zwlr_layer_surface_v1 rather than an xdg_toplevel, and a surface's role
    # cannot change once it is committed. That role is the whole reason the
    # panel appears already positioned instead of being placed mid-screen and
    # then dragged under the bar a frame later; sway-calendar carries the full
    # account of trying it the other way.
    GtkLayerShell.init_for_window(win)
    # The namespace, and the ONLY thing that sets it -- prgname does NOT, which
    # was measured the first time a layer_effects rule needed it. Must stay in
    # step with config/sway/sway-fx.
    GtkLayerShell.set_namespace(win, APP_ID)
    # OVERLAY, not TOP: TOP is waybar's own layer, so stacking against the bar
    # would be arbitrary.
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
    # ON_DEMAND, not EXCLUSIVE. The password field needs keys, but EXCLUSIVE
    # would hold the whole session's keyboard for as long as the panel is open.
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND)
    # 0, not -1: "reserve nothing, but respect what others reserved", which is
    # what makes GAP measure from below waybar rather than from the screen edge.
    GtkLayerShell.set_exclusive_zone(win, 0)
    # Anchored on all four edges so the surface fills the usable area and a
    # click outside the panel still reaches us -- see _on_button_press. Margins
    # stay zero here on purpose: with the surface full-bleed they would inset
    # the clickable region rather than the panel.
    for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                 GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
        GtkLayerShell.set_anchor(win, edge, True)

    if show_now:
        win.show_panel()

    try:
        with open(PIDFILE, "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass  # no toggle, but the panel still works -- do not fail on this

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                         lambda *_a: (win.toggle_visible(), True)[1])
    # Quit cleanly on SIGTERM so the finally below runs and no pidfile is left
    # behind. unix_signal_add defers to the main loop rather than running Python
    # inside a signal handler.
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM,
                         lambda *_a: (Gtk.main_quit(), False)[1])

    try:
        Gtk.main()
    finally:
        try:
            with open(PIDFILE) as f:
                if int(f.read().strip()) == os.getpid():
                    os.unlink(PIDFILE)
        except (OSError, ValueError):
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
