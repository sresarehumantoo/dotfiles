#!/usr/bin/env python3
"""sway-network -- wifi picker and network menu for sway.

Linked to ~/.local/bin/sway-network by modules/sway.go. Opened by MIDDLE-CLICKING
the network readout in waybar (config/waybar/config), or with $mod+n.

WHY MIDDLE-CLICK AND NOT LEFT -- every status readout in this bar left-clicks to
the swaync control center, and that is a rule rather than four separate choices:
the bar shows almost no numbers, so it only works if the numbers live one
PREDICTABLE click away. The specific tools hang off the secondary buttons, which
is exactly where sway-quickpanel already sits on `pulseaudio`. So:

    network   left   -> swaync-client -t -sw     (the numbers, like every readout)
              middle -> sway-network             (this: pick a network)
              right  -> nm-connection-editor     (edit a connection in full)

WHY THIS EXISTS -- joining a wifi network from this desktop used to mean
nm-connection-editor, which is a connection EDITOR: it lists saved profiles, not
what is in the air, and joining something new from it takes a dialog and six
fields. nm-applet's own menu is not available either -- its icon is deliberately
filtered out of the tray (see sway-tray-filter), and its menu is attached to that
icon. So there was no "show me the networks around me and let me click one".

WHAT IT TALKS TO -- NetworkManager's D-Bus API directly, not `nmcli`. Three
reasons, all of which cost something if you take the shell route instead:

  * THE PASSWORD NEVER REACHES A COMMAND LINE. `nmcli device wifi connect SSID
    password hunter2` puts the PSK in argv, where it is world-readable in
    /proc/<pid>/cmdline for as long as the process lives. AddAndActivateConnection
    takes it over the bus instead, which is the same route nm-applet uses.
  * ONE READ INSTEAD OF DOZENS. See the GetManagedObjects note on refresh().
  * State arrives as SIGNALS, so a connection going up redraws immediately
    rather than on the next poll.

nm-applet stays running and is NOT replaced by this: it is NetworkManager's
secret agent, the thing that prompts when a saved key is rejected or an 802.1X
network needs credentials, and it does that job with no icon on screen.

Keys:
    Escape          close the open row, or the panel
    Enter           in the password field, connect
    Tab / arrows    move between rows (ordinary GTK focus)
"""
import os
import signal
import sys


# -- The resident-server fast path --------------------------------------------
# Identical in shape to sway-calendar, and for the identical measured reason: the
# `gi` imports alone cost ~220ms, so a spawn-per-click panel cannot feel
# instant. The window is built ONCE by a server autostarted from
# config/sway/config, and a click merely signals it.
#
# The scan is the second reason, and it is specific to this panel. A cold
# NetworkManager scan takes seconds to fill in, so a panel that started scanning
# only when you clicked would open empty and populate under your cursor. The
# resident server is already subscribed when you open it, so the list is there
# in the first frame.
#
# Measured here, median of 7, against sway-calendar as the reference for what
# this desktop already accepts:
#
#     python3 -c pass ........  43 ms   (interpreter floor)
#     sway-calendar, client ..  92 ms
#     sway-network,  client ..  88 ms
#
# i.e. on par with its sibling, and nowhere near the ~300 ms a GTK import costs.
#
# ⚠ FILE SIZE IS A STARTUP COST HERE, WHICH IS NOT TRUE OF AN IMPORTED MODULE.
# A script run as __main__ is never bytecode-cached, so CPython recompiles the
# whole file on every invocation -- including the parts the fast path is about to
# skip. Measured: compiling this file takes 25.9 ms against sway-calendar's
# 7.5 ms, tracking their sizes (75 KB vs 35 KB). It does not dominate today, but
# it is the reason not to keep growing the file indefinitely, and it is why
# moving the fast path earlier cannot help any further -- compilation of
# everything below it has already happened by then.
#
# WARNING: THIS BLOCK MUST STAY ABOVE `import gi`. Module-level imports run at
# exec time, before main() is entered, so moving this logic into main() would
# pay the full GTK cost on the client path and buy nothing. sway-calendar
# records the measurement (~280ms/click) from when it had exactly that bug.
PIDFILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp/%d" % os.getuid(),
    "sway-network.pid")


def server_pid():
    """PID of the live server, or None. A stale pidfile reads as None."""
    try:
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return None
    if pid == os.getpid():
        return None
    try:
        os.kill(pid, 0)  # probe only
    except OSError:
        return None      # stale: a crash, or a reboot that left the file behind
    return pid


def signal_server(sig):
    """Send `sig` to the resident server. True if it was delivered."""
    pid = server_pid()
    if pid is None:
        return False
    try:
        os.kill(pid, sig)
        return True
    except OSError:
        return False


def client_fast_path(argv):
    """Exit code if this invocation needs no GTK at all, else None."""
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    if "--server" in argv:
        # Decline to become a second server. This is also why the autostart
        # needs no pgrep guard -- and it could not use one anyway, since
        # `pgrep -f sway-network` matches the shell that launched it.
        return 0 if server_pid() is not None else None
    if signal_server(signal.SIGUSR1):
        return 0  # the click path -- see the measurements above
    return None   # no server running -- fall through and become one


if __name__ == "__main__":
    _rc = client_fast_path(sys.argv[1:])
    if _rc is not None:
        sys.exit(_rc)


