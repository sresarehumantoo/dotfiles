#  NetworkManager
# =============================================================================
class NetworkManager:
    """Everything this panel knows about the network, over the system bus.

    Reads go through ONE `GetManagedObjects` call on org.freedesktop.DBus's
    ObjectManager at /org/freedesktop, which NetworkManager implements. That is
    not a micro-optimization, it is what makes a synchronous read acceptable at
    all -- measured on this box:

        per-object GetAll, 4 APs .............  15.8 ms
        GetManagedObjects, 103 objects .......  16.6 ms (78 ms cold, once)

    The first number scales with the number of access points, so a cafe with 40
    of them costs ~110 ms of frozen UI per refresh; the second scales with the
    total object count and barely moves. One call is also atomic, so the AP list
    and the active-connection list can never disagree about what is connected.

    SAVED CONNECTIONS ARE THE EXCEPTION AND ARE CACHED. Their settings are not
    D-Bus properties -- each one needs its own GetSettings call, and with 25
    saved profiles here that is ~65 ms. They change only when a profile is added
    or deleted, so the cache is built once at startup (while the server is
    hidden and nobody is waiting) and rebuilt on NewConnection /
    ConnectionRemoved.
    """

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self._subs = []
        self.saved_wifi = {}   # ssid str -> [{path, id, key_mgmt}]
        self.saved_vpn = []    # [{path, id, type}]
        self.reload_saved()

    # -- low-level -----------------------------------------------------------
    def _call(self, path, iface, method, args=None, timeout=4000):
        return self.bus.call_sync(NM, path, iface, method, args, None,
                                  Gio.DBusCallFlags.NONE, timeout, None)

    def _call_async(self, path, iface, method, args, done=None, timeout=45000):
        """Fire a method and report failure to `done`, never blocking the UI.

        Every ACTION goes through here. Activating a connection returns as soon
        as NM has accepted it -- association happens afterwards and arrives as
        state signals -- but `AddAndActivateConnection` on a busy supplicant and
        `Disconnect` on a wedged device can both take seconds, and a synchronous
        call would freeze the panel for exactly as long.
        """
        def _cb(_src, res):
            try:
                self.bus.call_finish(res)
                if done:
                    done(None)
            except GLib.Error as e:
                if done:
                    done(e.message)
        self.bus.call(NM, path, iface, method, args, None,
                      Gio.DBusCallFlags.NONE, timeout, None, _cb)

    def _get(self, path, iface, name):
        return self._call(path, I_PROPS, "Get",
                          GLib.Variant("(ss)", (iface, name))).unpack()[0]

    # -- saved connections ---------------------------------------------------
    def reload_saved(self):
        """Rebuild the SSID -> saved-profile map. See the class docstring."""
        self.saved_wifi = {}
        self.saved_vpn = []
        try:
            paths = self._get(NM_SETTINGS_PATH, I_SETTINGS, "Connections")
        except GLib.Error:
            return
        for path in paths:
            try:
                s = self._call(path, I_CONN, "GetSettings").unpack()[0]
            except GLib.Error:
                continue  # deleted between the list and the read
            conn = s.get("connection", {})
            ctype = conn.get("type", "")
            if ctype == "802-11-wireless":
                raw = s.get("802-11-wireless", {}).get("ssid")
                if raw is None:
                    continue
                # KEYED BY THE RAW OCTETS, NOT THE DECODED STRING. An SSID
                # is 32 arbitrary bytes (see ssid_str), so two different
                # networks can decode to the same replacement text; keying on
                # the display form would merge them and offer one's password to
                # the other.
                ssid = bytes(raw)
                # NOTE: ONE SSID CAN HAVE SEVERAL PROFILES, and this box has a
                # live example -- 'FoodArt-5GHz' and 'FoodArt-5GHz 1' carry the
                # same ssid. So this is a list, and "forget" deletes every entry
                # in it rather than the first match.
                self.saved_wifi.setdefault(ssid, []).append({
                    "path": path,
                    "id": conn.get("id", ssid_str(ssid)),
                    "key_mgmt": s.get("802-11-wireless-security", {})
                                 .get("key-mgmt", ""),
                })
            elif ctype in ("vpn", "wireguard"):
                self.saved_vpn.append(
                    {"path": path, "id": conn.get("id", path), "type": ctype})
        self.saved_vpn.sort(key=lambda c: c["id"].lower())

    # -- the snapshot --------------------------------------------------------
    def snapshot(self):
        """One atomic read of everything the UI draws. Never raises."""
        snap = {
            "ok": False, "wireless_enabled": False, "wireless_hw": True,
            "wifi_dev": None, "aps": [], "ethernet": [], "vpn": [],
            "active_ssid": None, "active_state": None, "last_scan": -1,
        }
        try:
            objs = self._call("/org/freedesktop", I_OBJMGR,
                              "GetManagedObjects").unpack()[0]
        except GLib.Error:
            return snap  # NM down or restarting: the UI shows the offline state
        snap["ok"] = True

        root = objs.get(NM_PATH, {}).get(I_NM, {})
        snap["wireless_enabled"] = bool(root.get("WirelessEnabled", False))
        snap["wireless_hw"] = bool(root.get("WirelessHardwareEnabled", True))

        # Active connections, indexed by the device they run on, so a device row
        # can name its profile without a second lookup.
        active_by_dev, active_by_conn = {}, {}
        for path, ifaces in objs.items():
            a = ifaces.get(I_ACTIVE)
            if not a:
                continue
            rec = {"path": path, "id": a.get("Id", ""), "type": a.get("Type", ""),
                   "state": a.get("State", 0), "conn": a.get("Connection", "/"),
                   "devices": list(a.get("Devices", []))}
            active_by_conn[rec["conn"]] = rec
            for d in rec["devices"]:
                active_by_dev[d] = rec

        def ip4_of(dev_props):
            path = dev_props.get("Ip4Config", "/")
            addrs = objs.get(path, {}).get(I_IP4, {}).get("AddressData", [])
            if not addrs:
                return None
            a = addrs[0]
            return "%s/%s" % (a.get("address", "?"), a.get("prefix", "?"))

        # Devices. DeviceType is the only safe discriminator here -- see the
        # constants block for the veth/bridge trap this box demonstrates.
        wifi_props = None
        for path, ifaces in objs.items():
            d = ifaces.get(I_DEV)
            if not d:
                continue
            dtype = d.get("DeviceType", 0)
            if dtype == DEV_WIFI and wifi_props is None:
                wifi_props = (path, d, ifaces.get(I_WIFI, {}))
            elif dtype == DEV_ETHERNET:
                act = active_by_dev.get(path)
                snap["ethernet"].append({
                    "path": path, "iface": d.get("Interface", "?"),
                    "state": d.get("State", 0), "ip": ip4_of(d),
                    "active": act,
                    "available": list(d.get("AvailableConnections", [])),
                })
            elif dtype in (DEV_TUN, DEV_WIREGUARD):
                # An UNMANAGEABLE tunnel: tailscale0 here, and openvpn's tun0
                # when an HTB box is up. NM auto-generates a `tun` profile for a
                # device somebody else created, so it appears in the list, but
                # deactivating it from here would fight whatever owns it. These
                # are shown READ-ONLY -- what NM genuinely owns arrives instead
                # through saved_vpn below, as a real toggle.
                act = active_by_dev.get(path)
                if act and act["type"] in ("tun", "wireguard"):
                    snap["vpn"].append({
                        "kind": "external", "id": act["id"],
                        "iface": d.get("Interface", "?"),
                        "ip": ip4_of(d), "state": act["state"],
                    })

        snap["ethernet"].sort(key=lambda e: e["iface"])

        # VPN and WireGuard profiles NM owns: real toggles.
        for c in self.saved_vpn:
            act = active_by_conn.get(c["path"])
            snap["vpn"].append({
                "kind": "managed", "id": c["id"], "type": c["type"],
                "path": c["path"], "active": act,
                "state": act["state"] if act else 0,
            })

        if wifi_props is None:
            return snap  # no wifi hardware: the whole wifi section is hidden
        dev_path, dev, wifi = wifi_props
        snap["wifi_dev"] = {"path": dev_path, "iface": dev.get("Interface", "?"),
                            "state": dev.get("State", 0), "ip": ip4_of(dev),
                            "bitrate": wifi.get("Bitrate", 0)}
        snap["last_scan"] = wifi.get("LastScan", -1)
        active_ap = wifi.get("ActiveAccessPoint", "/")
        act = active_by_dev.get(dev_path)
        if act:
            snap["active_ssid"] = act["id"]
            snap["active_state"] = act["state"]

        # ONE ROW PER SSID, STRONGEST BSS WINS. Not cosmetic: a dual-band router
        # publishes one AP object per band, so this box shows '32Bytes' twice
        # with nothing to tell the rows apart, and any router with roaming
        # repeaters shows it once per repeater.
        by_ssid = {}
        for path, ifaces in objs.items():
            p = ifaces.get(I_AP)
            if not p:
                continue
            raw = bytes(p.get("Ssid", b""))
            if not raw:
                continue  # a hidden AP broadcasts an empty SSID; nothing to show
            ssid = ssid_str(raw)
            rec = {
                "ssid": ssid, "ssid_raw": raw, "path": path,
                "strength": int(p.get("Strength", 0)),
                "flags": p.get("Flags", 0),
                "wpa": p.get("WpaFlags", 0), "rsn": p.get("RsnFlags", 0),
                "freq": p.get("Frequency", 0),
                "is_active": path == active_ap,
            }
            cur = by_ssid.get(raw)
            if cur is None or rec["strength"] > cur["strength"]:
                # Keep the active flag even if a weaker BSS is the connected
                # one -- the row must still read as connected.
                if cur is not None and cur["is_active"]:
                    rec["is_active"] = True
                by_ssid[raw] = rec
            elif rec["is_active"]:
                cur["is_active"] = True

        aps = list(by_ssid.values())
        for ap in aps:
            ap["saved"] = self.saved_wifi.get(ap["ssid_raw"], [])
            ap["security"] = ap_security(ap)
        # Connected first, then saved, then by signal. Anything you are likely
        # to want is above the fold without scrolling.
        aps.sort(key=lambda a: (not a["is_active"], not a["saved"],
                                -a["strength"], a["ssid"].lower()))
        snap["aps"] = aps
        return snap

    # -- signals -------------------------------------------------------------
    def subscribe(self, handler):
        """Watch everything that can change what the panel is drawing.

        Only called while the panel is VISIBLE; unsubscribe() runs on hide, so a
        server nobody has opened receives nothing and wakes for nothing.

        The AccessPoint rule is a single subscription covering EVERY access
        point, matched on arg0 of PropertiesChanged rather than on a path, so
        adding an AP does not need a new watch -- signal strengths update
        without this panel enumerating anything.
        """
        watches = [
            (I_PROPS, "PropertiesChanged", None, I_AP),
            (I_PROPS, "PropertiesChanged", NM_PATH, None),
            (I_WIFI, "AccessPointAdded", None, None),
            (I_WIFI, "AccessPointRemoved", None, None),
            (I_DEV, "StateChanged", None, None),
            (I_ACTIVE, "StateChanged", None, None),
            (I_SETTINGS, "NewConnection", None, None),
            (I_SETTINGS, "ConnectionRemoved", None, None),
        ]
        for iface, member, path, arg0 in watches:
            self._subs.append(self.bus.signal_subscribe(
                NM, iface, member, path, arg0,
                Gio.DBusSignalFlags.NONE,
                lambda *a, _m=member: handler(_m)))

    def unsubscribe(self):
        for sid in self._subs:
            self.bus.signal_unsubscribe(sid)
        self._subs = []

    # -- actions -------------------------------------------------------------
    def set_wireless_enabled(self, on, done=None):
        self._call_async(NM_PATH, I_PROPS, "Set",
                         GLib.Variant("(ssv)", (I_NM, "WirelessEnabled",
                                                GLib.Variant("b", on))),
                         done, timeout=8000)

    def request_scan(self):
        dev = None
        try:
            for d in self._get(NM_PATH, I_NM, "Devices"):
                if self._get(d, I_DEV, "DeviceType") == DEV_WIFI:
                    dev = d
                    break
        except GLib.Error:
            return
        if dev:
            # Failure here is routine and must stay silent: NM rate-limits
            # scanning, and a refused rescan simply means the list you already
            # have is recent enough.
            self._call_async(dev, I_WIFI, "RequestScan",
                             GLib.Variant("(a{sv})", ({},)), None, timeout=8000)

    def activate(self, conn_path, dev_path, ap_path="/", done=None):
        self._call_async(NM_PATH, I_NM, "ActivateConnection",
                         GLib.Variant("(ooo)", (conn_path, dev_path, ap_path)),
                         done)

    def add_and_activate(self, settings, dev_path, ap_path, done=None):
        self._call_async(NM_PATH, I_NM, "AddAndActivateConnection",
                         GLib.Variant("(a{sa{sv}}oo)",
                                      (settings, dev_path, ap_path)), done)

    def deactivate(self, active_path, done=None):
        self._call_async(NM_PATH, I_NM, "DeactivateConnection",
                         GLib.Variant("(o)", (active_path,)), done)

    def disconnect_device(self, dev_path, done=None):
        self._call_async(dev_path, I_DEV, "Disconnect", None, done)

    def delete_connection(self, conn_path, done=None):
        self._call_async(conn_path, I_CONN, "Delete", None, done)


