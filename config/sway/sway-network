# =============================================================================
#  Reading what NetworkManager reports
# =============================================================================
def ssid_str(raw):
    """Decode an SSID byte array for display.

    An SSID is 32 arbitrary OCTETS, not a string -- 802.11 does not require it
    to be UTF-8, and this box carries live proof that the escape hatch is used
    in practice: two saved profiles named '/6F/77/65/6E' and 'x6Fx77x65x6E'.
    So decode leniently and never raise; a replacement character in one row is
    survivable, an exception that empties the whole list is not.
    """
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("utf-8", "replace")


def ap_security(ap):
    """('open' | 'psk' | 'sae' | 'owe' | 'enterprise', human label)."""
    rsn, wpa, flags = ap["rsn"], ap["wpa"], ap["flags"]
    both = rsn | wpa
    if both & SEC_ENTERPRISE:
        return ("enterprise", "WPA2-Enterprise" if not (rsn & SEC_KEY_MGMT_EAP_SUITE_B)
                else "WPA3-Enterprise")
    if rsn & SEC_KEY_MGMT_SAE:
        # A transitional AP advertises SAE and PSK together. Prefer SAE: NM
        # negotiates down by itself, and asking for wpa-psk on a WPA3-only AP
        # fails outright.
        return ("sae", "WPA3")
    if both & SEC_KEY_MGMT_PSK:
        return ("psk", "WPA2" if rsn else "WPA")
    if both & (SEC_KEY_MGMT_OWE | SEC_KEY_MGMT_OWE_TM):
        return ("owe", "Open (encrypted)")
    if flags & AP_FLAGS_PRIVACY:
        # PRIVACY with no WPA/RSN flags at all is WEP, which NM can still join
        # and which no password field here can express safely.
        return ("enterprise", "WEP")
    return ("open", "Open")


def wifi_icon(strength):
    """The bar's ramp, so a row and the bar's glyph can never disagree.

    Four icons over 0-100, matching config/waybar/config: the buckets are
    [0-24] [25-49] [50-74] [75-100].
    """
    return ICON_WIFI[min(3, max(0, int(strength)) * len(ICON_WIFI) // 100)]


def band_label(freq_mhz):
    if freq_mhz >= 5925:
        return "6 GHz"
    if freq_mhz >= 4900:
        return "5 GHz"
    if freq_mhz:
        return "2.4 GHz"
    return ""


DEBUG = bool(os.environ.get("SWAY_NETWORK_DEBUG"))


def dbg(fmt, *args):
    """Trace to stderr under SWAY_NETWORK_DEBUG=1.

    Worth keeping: every interesting failure in a layer-shell panel is about
    an event that did or did not arrive (the spurious post-map focus-out, a
    click landing outside the panel box, a dismissal nobody asked for), and
    none of that is visible from a screenshot -- a hidden panel and a panel
    that was never shown look identical.
    """
    if DEBUG:
        print("sway-network: " + (fmt % args if args else fmt), file=sys.stderr,
              flush=True)


def boottime_ms():
    """Milliseconds on CLOCK_BOOTTIME, which is what NM's LastScan counts.

    WARNING: GLib.get_monotonic_time() IS THE WRONG CLOCK AND THE ERROR IS
    INVISIBLE UNTIL THE MACHINE SLEEPS. CLOCK_MONOTONIC stops during suspend
    and CLOCK_BOOTTIME does not, so on this laptop, measured immediately after
    a resume:

        LastScan (BOOTTIME)  904865097
        CLOCK_BOOTTIME       904890608   <- 25 s ago, correct
        CLOCK_MONOTONIC      322709482   <- 582 s adrift, i.e. every scan looks
                                            ten minutes in the future

    which would leave the footer permanently claiming a scan was in flight.
    The identical suspend-versus-wall-clock trap is what breaks vault-agent's
    renewal timer; see the global CLAUDE.md.
    """
    import time
    return int(time.clock_gettime(time.CLOCK_BOOTTIME) * 1000)

