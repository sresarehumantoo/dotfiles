#!/usr/bin/env python3
"""sway-quickpanel — floating volume + brightness sliders for sway.

Linked to ~/.local/bin/sway-quickpanel by modules/sway.go. Opened by
left-clicking the volume or brightness readout in waybar (config/waybar/config).

WHY THIS EXISTS — waybar's own pulseaudio/slider and backlight/slider were
tried first, in the bar, and abandoned as unusable for daily driving: the
pointer had to be very precise or the handle would jump around.
The cause is upstream and not configurable — waybar's ASlider::update() calls
set_value() on the very widget you are holding, with no drag interlock:

  * backlight/slider re-asserts on its poll interval (default 1000ms), so the
    handle is yanked back roughly once a second mid-drag.
  * pulseaudio/slider is driven by PulseAudio subscribe events, so every write
    your own drag causes fires an event that re-sets the handle. There is no
    config lever for this one at all.

src/ASlider.cpp is unchanged since 2024-02-15 and identical on master, so no
waybar release fixes it. See also upstream #3249 and #4089.

⚠ A plausible-sounding but WRONG explanation was chased first: that layer-shell
surfaces cannot hold a pointer grab, so motion stops when the cursor leaves the
bar. That is false. sway's seatop_down forwards motion with no bounds check and
never sends wl_pointer.leave mid-press (fixed by sway PR #6418, in since 1.7),
and GDK3 routes it via its automatic implicit grab. Do not re-derive that
theory; the grab works fine.

This window is a plain xdg_toplevel and does no write-back at all — it only
ever writes outward — so neither problem applies.

Controls:
    Volume      wpctl         (PipeWire)
    Brightness  sysfs directly, brightnessctl as fallback

Closes on Escape, or when it loses focus — except while a slider is actively
being dragged, so releasing the button outside the window cannot dismiss it
mid-adjustment.

Run with --profile to print main-loop stall statistics on exit; that is how the
rendering cost below was found.
"""
import glob
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import GLib, Gdk, Gio, Gtk  # noqa: E402

APP_ID = "sway-quickpanel"

# Floor, not 0: a fully dark panel is indistinguishable from the laptop being
# off, and there is no on-screen way back. Matches backlight/slider in
# config/waybar/config.
BRIGHTNESS_MIN = 5

# Coalesce writes while dragging. A GtkScale emits value-changed on every
# pixel; intel_backlight is a 96000-step raw device and writing that burst is
# what makes the panel visibly step. ~50Hz is smooth to the eye while still
# cutting the write rate several-fold.
#
# ⚠ This is a rate limit, NOT a substitute for the writes being non-blocking.
# The first version of this script called subprocess.run() straight from the
# value-changed handler. Measured on this box: `wpctl set-volume` forks in
# ~27ms and `brightnessctl set` in ~16ms, so at one write per 50ms the GTK
# main loop was blocked over half the time, motion events queued up, and the
# slider visibly lagged the cursor by seconds. Everything below stays off the
# main loop: brightness writes sysfs directly (~0.1ms) and volume goes through
# Gio.Subprocess asynchronously.
WRITE_COALESCE_MS = 20

CSS = b"""
window { background-color: #1e1e2e; }
box.panel { padding: 14px 16px; }
label.row { color: #a6adc8; font-family: "IosevkaTerm Nerd Font", monospace; font-size: 13px; }
label.value { color: #cdd6f4; font-family: "IosevkaTerm Nerd Font", monospace; font-size: 13px; }
scale trough { min-height: 14px; border-radius: 7px; background-color: #313244; }
/* No box-shadow on the handle: GTK re-rasterises a shadow every frame the
   widget is redrawn, which during a scrub is every frame. */
scale slider {
    min-width: 16px; min-height: 16px; border-radius: 50%;
    background-color: #cdd6f4; background-image: none; border: none;
}
scale.volume     highlight { background-color: #a6e3a1; border-radius: 7px; }
scale.brightness highlight { background-color: #f9e2af; border-radius: 7px; }
"""


def run(cmd):
    """Run a command synchronously, returning stdout or None. Never raises.

    Startup reads only — never call this from a value-changed handler, see the
    note on WRITE_COALESCE_MS.
    """
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=2)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


class AsyncCommand:
    """Fire-and-forget command runner with latest-wins coalescing.

    Keeps at most one process in flight. A request arriving while one is
    running replaces any previously queued request, so a fast drag collapses
    to "whatever the value was when the last process exited" instead of
    queueing a backlog of stale writes.
    """

    def __init__(self):
        self.busy = False
        self.pending = None

    def send(self, argv):
        if self.busy:
            self.pending = argv
            return
        self._spawn(argv)

    def _spawn(self, argv):
        self.busy = True
        try:
            proc = Gio.Subprocess.new(
                argv,
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
        except GLib.Error:
            self.busy = False
            return
        proc.wait_async(None, self._on_done)

    def _on_done(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            pass
        self.busy = False
        if self.pending is not None:
            argv, self.pending = self.pending, None
            self._spawn(argv)


_volume_cmd = AsyncCommand()
_backlight_cmd = AsyncCommand()


def _backlight_dev():
    """First backlight device, or None. Not hardcoded to intel_backlight."""
    devs = sorted(glob.glob("/sys/class/backlight/*"))
    return devs[0] if devs else None


_BL = _backlight_dev()
_BL_MAX = None
if _BL:
    try:
        _BL_MAX = int(open(os.path.join(_BL, "max_brightness")).read().strip())
    except (OSError, ValueError):
        _BL_MAX = None


def get_volume():
    out = run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    if not out:
        return None
    # "Volume: 0.45" or "Volume: 0.45 [MUTED]"
    try:
        return round(float(out.split()[1]) * 100)
    except (IndexError, ValueError):
        return None


def set_volume(pct):
    # ~27ms to fork, so it must not run on the main loop.
    _volume_cmd.send(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(pct)}%"])


def brightness_to_user(real):
    """Rebase the hardware percentage onto a 0-100 user scale.

    BRIGHTNESS_MIN is the lowest value the panel may take, so the hardware
    range is really BRIGHTNESS_MIN..100. Reporting the raw number would make
    the slider bottom out reading "5%" — a control that looks broken rather
    than floored. Every desktop OS rebases here instead: Android maps its
    slider onto [screenBrightnessSettingMinimum, max], GNOME's gsd-backlight
    clamps to the lowest non-zero step. The floor is real; the zero is the
    honest way to present it.

    config/sway/sway-brightness applies the identical mapping to the
    XF86MonBrightness keys — change the formula in one and you must change it
    in the other, or the keys and this slider will disagree.
    """
    span = 100 - BRIGHTNESS_MIN
    if real <= BRIGHTNESS_MIN or span <= 0:
        return 0
    return round((real - BRIGHTNESS_MIN) * 100 / span)


def get_brightness():
    if _BL and _BL_MAX:
        try:
            cur = int(open(os.path.join(_BL, "brightness")).read().strip())
            return round(cur / _BL_MAX * 100)
        except (OSError, ValueError):
            pass
    out = run(["brightnessctl", "-m"])
    if not out:
        return None
    # "intel_backlight,backlight,13440,14%,96000"
    try:
        cur, mx = int(out.split(",")[2]), int(out.split(",")[4])
        return round(cur / mx * 100)
    except (IndexError, ValueError, ZeroDivisionError):
        return None


def set_brightness(pct):
    """Write sysfs directly (~0.1ms) rather than forking brightnessctl (~16ms).

    Requires a udev rule granting the `video` group write access to the
    backlight attribute, and the invoking user to be in `video` -- then this
    needs neither root nor a setuid helper. Debian's brightnessctl ships no
    such rule; see config/sway/90-backlight.rules for the one this expects.
    Without it the write raises EACCES and we fall back to brightnessctl
    asynchronously, which still works but is slower.
    """
    if _BL and _BL_MAX:
        raw = max(1, min(_BL_MAX, round(pct / 100 * _BL_MAX)))
        try:
            with open(os.path.join(_BL, "brightness"), "w") as f:
                f.write(str(raw))
            return
        except OSError:
            pass
    _backlight_cmd.send(["brightnessctl", "-q", "set", f"{int(pct)}%"])


class Row:
    """One labelled slider with coalesced writes."""

    def __init__(self, icon, name, style, lo, hi, getter, setter, to_display=None):
        self.setter = setter
        # Maps the REAL value the hardware takes onto the number shown to the
        # user. Identity for volume; for brightness it rebases the floor to
        # zero so the bottom of the slider reads 0% while the panel is still
        # lit — see BRIGHTNESS_MIN and config/sway/sway-brightness, which
        # applies the same mapping to the keyboard keys. Without it the slider
        # bottoms out reading "5%", which looks like a control that refuses to
        # go all the way down rather than one with a deliberate floor.
        self.to_display = to_display or (lambda v: v)
        self.pending = None
        self.timer = None
        self.dragging = False
        self.last_shown = None

        self.label = Gtk.Label(label=f"{icon}  {name}", xalign=0.0)
        self.label.get_style_context().add_class("row")

        self.value_label = Gtk.Label(label="--%", xalign=1.0)
        self.value_label.get_style_context().add_class("value")
        self.value_label.set_width_chars(5)

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
        self.scale.set_draw_value(False)
        self.scale.set_size_request(260, -1)
        self.scale.get_style_context().add_class(style)

        current = getter()
        self.available = current is not None
        if self.available:
            self.scale.set_value(max(lo, min(hi, current)))
            self.value_label.set_text(f"{self.to_display(current)}%")
        else:
            # Tool missing or failed — show the row disabled rather than
            # silently pretending the control works.
            self.scale.set_sensitive(False)
            self.value_label.set_text("n/a")

        self.scale.connect("value-changed", self._on_changed)
        self.scale.connect("button-press-event", self._on_press)
        self.scale.connect("button-release-event", self._on_release)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header.pack_start(self.label, True, True, 0)
        header.pack_end(self.value_label, False, False, 0)

        self.widget = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.widget.pack_start(header, False, False, 0)
        self.widget.pack_start(self.scale, False, False, 0)

    def _on_press(self, *_):
        self.dragging = True
        return False

    def _on_release(self, *_):
        self.dragging = False
        self._flush()
        return False

    def _on_changed(self, scale):
        t0 = time.monotonic() if PROFILER else 0
        v = int(scale.get_value())
        if v != self.last_shown:
            self.last_shown = v
            self.value_label.set_text(f"{self.to_display(v)}%")
        self._changed_body(v)
        if PROFILER:
            PROFILER.record_handler((time.monotonic() - t0) * 1000)

    def _changed_body(self, v):
        self.pending = v
        if self.timer is None:
            self.timer = GLib.timeout_add(WRITE_COALESCE_MS, self._flush, True)

    def _flush(self, from_timer=False):
        # When the timer fires it owns the source and returning False removes
        # it; a manual flush (release / quit) must remove it explicitly or the
        # pending callback fires against a stale value.
        if not from_timer and self.timer is not None:
            GLib.source_remove(self.timer)
        self.timer = None
        if self.pending is not None:
            self.setter(self.pending)
            self.pending = None
        return False  # do not repeat


class QuickPanel(Gtk.Window):
    def __init__(self):
        super().__init__(title="Quick settings")
        self.set_default_size(300, -1)
        self.set_resizable(False)

        self.rows = [
            Row("\U000f057e", "Volume", "volume", 0, 100, get_volume, set_volume),
            Row("\U000f00e0", "Brightness", "brightness",
                BRIGHTNESS_MIN, 100, get_brightness, set_brightness,
                to_display=brightness_to_user),
        ]

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.get_style_context().add_class("panel")
        for r in self.rows:
            box.pack_start(r.widget, False, False, 0)
        self.add(box)

        self.connect("key-press-event", self._on_key)
        self.connect("focus-out-event", self._on_focus_out)
        self.connect("destroy", Gtk.main_quit)

    def _on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self._quit()
        return False

    def _on_focus_out(self, *_):
        # Never dismiss mid-drag: releasing the button outside the window is a
        # normal way to finish a drag, and closing there would discard it.
        if any(r.dragging for r in self.rows):
            return False
        self._quit()
        return False

    def _quit(self):
        for r in self.rows:
            r._flush()
        Gtk.main_quit()


class LoopProfiler:
    """Detect main-loop stalls from inside the loop itself.

    A timeout scheduled every TICK_MS can only be dispatched when the main
    loop is free, so the gap between expected and actual dispatch IS the
    stall. This measures what the user actually feels, rather than timing
    individual functions and hoping we picked the guilty one.
    """

    TICK_MS = 10

    def __init__(self):
        self.stalls = []
        self.last = time.monotonic()
        self.handler_ms = []
        GLib.timeout_add(self.TICK_MS, self._tick)

    def _tick(self):
        now = time.monotonic()
        gap = (now - self.last) * 1000
        self.last = now
        over = gap - self.TICK_MS
        if over > 5:
            self.stalls.append(over)
        return True

    def record_handler(self, ms):
        self.handler_ms.append(ms)

    def report(self):
        out = ["", "=== main-loop profile ==="]
        if self.stalls:
            s = sorted(self.stalls)
            out.append(f"  stalls >5ms : {len(s)}")
            out.append(f"  worst       : {s[-1]:.1f}ms")
            out.append(f"  median stall: {s[len(s)//2]:.1f}ms")
            out.append(f"  total stalled: {sum(s):.0f}ms")
        else:
            out.append("  no stalls over 5ms — main loop stayed responsive")
        if self.handler_ms:
            h = sorted(self.handler_ms)
            out.append(f"  value-changed handlers: n={len(h)} "
                       f"median={h[len(h)//2]:.3f}ms max={h[-1]:.3f}ms "
                       f"total={sum(h):.0f}ms")
        return "\n".join(out)


PROFILER = None


def main():
    global PROFILER

    # sway reads app_id from prgname for plain GTK3 toplevels; this is what the
    # `for_window [app_id="sway-quickpanel"]` rule will match on.
    GLib.set_prgname(APP_ID)

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    if "--profile" in sys.argv:
        PROFILER = LoopProfiler()
        globals()["PROFILER"] = PROFILER
        print("profiling: scrub the sliders, then press Escape", file=sys.stderr)

    win = QuickPanel()
    if not any(r.available for r in win.rows):
        print("neither wpctl nor brightnessctl is usable", file=sys.stderr)
        return 1
    win.show_all()
    win.present()
    Gtk.main()
    if PROFILER:
        print(PROFILER.report(), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
