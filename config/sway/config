### Session ---------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+x exec $lock

### Notifications ---------------------------------------------------------
# The keyboard route to swaync's control centre; the bell in waybar is the
# pointer one (see "custom/notification" in config/waybar/config). Before these
# two existed the panel had no opener at all, so a notification that timed out
# was simply unrecoverable — the history was being kept and never shown.
#
# -sw ("skip wait") makes the client start swaync if it is not running rather
# than blocking; without it this key does nothing at all on the rare occasion
# the daemon has died, with no feedback.
bindsym $mod+n       exec swaync-client -t -sw
# Push the newest popup off screen without opening the panel — it stays in the
# control centre, so this is "not now", not "delete". swaync has no hide-all,
# only hide-latest, so repeated presses peel them off one at a time. Do NOT
# reach for -C here: that is close-all, which drops them from the history too.
bindsym $mod+Shift+n exec swaync-client --hide-latest -sw

### Media / laptop keys ---------------------------------------------------
# ⚠ Each of these is written as `swayosd-client ... || <fallback>` on purpose.
# swayosd draws the on-screen level overlay, and it is what makes the bar's
# missing volume/brightness percentages a feature rather than a loss: the
# number appears centre-screen exactly while you are changing it. But this repo
# also configures machines that do not have it, so every key degrades to the
# old direct command instead of silently doing nothing. Test the fallback by
# temporarily renaming swayosd-client, NOT by trusting the `||`.
#
# ⚠ Do NOT drop the `sh -c`. sway execs the command through /bin/sh already,
# but `||` inside a bindsym is parsed by sway's own tokenizer first; wrapping
# it keeps the shell operator with the shell.
bindsym --locked XF86AudioRaiseVolume  exec sh -c 'swayosd-client --output-volume raise  || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+'
bindsym --locked XF86AudioLowerVolume  exec sh -c 'swayosd-client --output-volume lower  || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
bindsym --locked XF86AudioMute         exec sh -c 'swayosd-client --output-volume mute-toggle || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
bindsym --locked XF86AudioMicMute      exec sh -c 'swayosd-client --input-volume mute-toggle  || wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
# ⚠ Brightness does NOT go through swayosd-client directly, unlike volume.
# swayosd 0.1.0 (Debian trixie) has no minimum and will drive the backlight to
# 0 — a black screen you then have to fix by feel. sway-brightness owns both
# the floor and the 0-100 user scale; see its header. Absolute path because GDM
# starts sway without a login shell, so ~/.local/bin is not on PATH.
bindsym --locked XF86MonBrightnessUp   exec $HOME/.local/bin/sway-brightness up
bindsym --locked XF86MonBrightnessDown exec $HOME/.local/bin/sway-brightness down
bindsym --locked XF86AudioPlay         exec playerctl play-pause
bindsym --locked XF86AudioNext         exec playerctl next
bindsym --locked XF86AudioPrev         exec playerctl previous

### Screenshots -----------------------------------------------------------
bindsym Print       exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy

### Window rules ----------------------------------------------------------
# Float dialogs rather than tiling them — mouse-friendliness again.
for_window [window_role="dialog"]        floating enable
for_window [window_role="pop-up"]        floating enable
for_window [window_type="dialog"]        floating enable
for_window [app_id="pavucontrol"]        floating enable
# Volume + brightness quick panel, opened by left-clicking those readouts in
# waybar. It replaces waybar's own in-bar sliders, which were unusable — see
# the WHY THIS EXISTS block in config/sway/sway-quickpanel.
for_window [app_id="sway-quickpanel"]    floating enable
for_window [app_id="sway-quickpanel"]    border pixel 2
for_window [app_id="sway-quickpanel"]    sticky enable
# ⚠ sway-calendar DELIBERATELY HAS NO for_window RULES, and adding them is a
# no-op rather than an error. It is a zwlr_layer_shell_v1 surface (like waybar
# and swaync), not an xdg_toplevel, so it never appears in the window tree and no
# `[app_id="sway-calendar"]` criteria can ever match it — floating/border/sticky
# are all meaningless for it, and it gets no client.focused border at all.
#
# It began as a plain toplevel with those three rules, exactly like the
# quickpanel above. The reason it moved: a Wayland client cannot position its own
# toplevel, so sway placed it mid-screen and a `swaymsg move absolute position`
# dragged it under the clock a frame later — VISIBLY. A layer surface takes its
# position from the initial configure, so there is nothing to move. Full write-up
# in docs/sway.md and the script's docstring.
for_window [app_id="blueman-manager"]    floating enable
for_window [app_id="nm-connection-editor"] floating enable

### Idle / lock -----------------------------------------------------------
exec swayidle -w \
    timeout 600  "$lock" \
    timeout 900  'swaymsg "output * power off"' \
        resume   'swaymsg "output * power on"' \
    before-sleep "$lock"

# Lid close → lock (not suspend; logind still handles suspend policy).
bindswitch --reload --locked lid:on exec $lock

### Autostart ------------------------------------------------------------
# Reload-SAFE autostart. Do NOT go back to the pattern of a separate
# `exec_always pkill -x <app>` line followed by `exec_always <app>`: sway forks
# exec lines ASYNCHRONOUSLY, so the pkill races the launch and kills the
# just-started instance. That pattern drops waybar on EVERY `swaymsg reload`
# and intermittently on fresh login. Merging into one `pkill -x waybar; waybar`
# does NOT fix it either — killing waybar and relaunching within one command
# loses the bar at any delay (0/0.5/1s all tested) on a DisplayLink
# primary-GPU-scanout setup. The rule that works: reload the RUNNING instance
# in place, and only spawn one if none is running. Never kill-and-respawn.
# (`||` and `>` below are handled by sh -c, not sway's parser.)
exec_always pkill -SIGUSR2 -x waybar || waybar     # waybar reloads its config on SIGUSR2

# SwayFX visual effects — blur, rounded corners, shadows, animations.
#
# ⚠ THE EFFECTS ARE NOT DIRECTIVES IN THIS FILE, AND MUST NOT BECOME ONE. This
# config is shared by all three GDM sessions, and plain sway does not ignore an
# unknown command — it fails the whole config load ("Error(s) loading config!",
# exit 1) and greets you with a swaynag. The fallback session is the recovery
# path; it must stay clean. The script applies everything over IPC and no-ops
# silently when the compositor is not SwayFX. Full reasoning in its header.
#
# ⚠ Absolute via $HOME — GDM starts sway without a login shell, so ~/.local/bin
# is not on the session PATH. Third time this repo has hit that.
#
# exec_always, deliberately: `swaymsg reload` resets runtime-applied effects
# back to what this file says (i.e. none), so re-running here is what makes a
# reload the correct way to re-apply after editing the script.
exec_always $HOME/.local/bin/sway-fx
# swaync, not mako: mako 1.10 has no fade/animation/opacity option of any kind,
# so notifications could only blink out instantly. swaync animates them
# (transition-time in config/swaync/config.json).
# ⚠ THE CONDITION IS `pgrep`, NOT THE RELOAD'S EXIT CODE. This line used to read
#     if swaync-client --reload-config; then ... else swaync; fi
# on the assumption that the reload FAILS when no daemon is running, so the
# `else` would launch one. It does not fail — it BLOCKS, printing
#     Could not connect to CC service. Will wait for connection...
# and waits forever for a daemon that nothing is left to start. So on any
# session where swaync was not already up, this line hung at login and swaync
# never started at all: no control centre, and the waybar bell silently doing
# nothing (its `-sw` gives up rather than launching — see config/waybar/config).
# Observed live: the hung `swaync-client --reload-config` was still sitting
# there 24 minutes into the session, sway's exec_always never having returned.
#
# Waiting is the documented default; `-sw`/`--skip-wait` is opt-out. So decide
# on whether the process exists, exactly as the swayosd line below does, and
# never on what the client returns.
#
# ⚠ `-sw` MUST FOLLOW THE ACTION FLAG, not precede it. swaync-client takes one
# option: `swaync-client -sw --reload-config` prints its usage and exits **0**,
# which looks like success and reloads nothing. `--reload-config -sw` is right.
#
# ⚠ Still if/then/else, NOT `A && B || swaync`: with that precedence a
# successful --reload-config followed by a FAILED --reload-css (an invalid
# stylesheet) falls through to `||` and spawns a SECOND daemon alongside the
# running one.
# ⚠ mako is still INSTALLED as a fallback and its config is still managed. To
# go back, swap this line for:  exec_always makoctl reload || mako
exec_always sh -c 'command -v swaync >/dev/null 2>&1 || exit 0; if pgrep -x swaync >/dev/null 2>&1; then swaync-client --reload-config -sw && swaync-client --reload-css -sw; else swaync & fi'

# swayosd — the on-screen volume/brightness/caps-lock overlay the media keys
# above drive. Optional: absent binary means the keys fall back to wpctl and
# brightnessctl, so this line no-ops rather than erroring.
#
# ⚠ Guarded with pgrep rather than the pkill-and-relaunch shape used for
# waybar. This is exec_always, so it re-runs on every `swaymsg reload`, and
# swayosd-server holds the layer-shell surface — restarting it on each reload
# would flash the overlay away mid-use for no benefit. Start-if-absent is
# enough because the server is stateless.
exec_always sh -c 'command -v swayosd-server >/dev/null 2>&1 && ! pgrep -x swayosd-server >/dev/null && swayosd-server &'

# sway-calendar as a RESIDENT SERVER, started hidden. Clicking the clock in
# waybar signals it (SIGUSR1) to toggle, which costs ~65ms instead of the ~366ms
# a fresh Python+GTK process needs — measured, and 260ms of that is fixed
# interpreter and GTK init before any of the script's own code runs, so
# spawn-per-click cannot be made to feel responsive.
#
# ⚠ `--anchor` MUST MATCH WHERE THE CLOCK IS in config/waybar/config, because the
# SERVER owns the geometry now — the click path only delivers a signal and cannot
# pass an anchor. Clock in modules-center -> `--anchor center`.
#
# ⚠ NO pgrep GUARD, deliberately, and do not add one. `pgrep -f sway-calendar`
# would match the `sh -c` running this very line — the same self-match trap the
# autotiling comment above records — so it could never fire. The script guards
# itself instead: `--server` checks its own pidfile and declines to start a second
# resident instance, which is what makes this safe under `exec_always` re-running
# on every `swaymsg reload`. Absolute path for the same GDM/PATH reason as the
# brightness keys.
exec_always sh -c '[ -x "$HOME/.local/bin/sway-calendar" ] && "$HOME/.local/bin/sway-calendar" --server --anchor center &'

# Dynamic-tiling approximation over sway IPC — the mitigation for sway being
# manual-tiling. Comment this out to judge plain sway.
# Plain `exec` (NOT exec_always): start one autotiling at login and leave it.
# It has no config to reload, so re-running it on every `swaymsg reload` only
# leaked duplicates. Two dead-ends that look tempting: `exec_always pkill -x
# autotiling; autotiling` never matches (autotiling runs as comm `python3`, so
# `pgrep -x autotiling` reports it absent while it runs), and a `pgrep -f
# /usr/bin/autotiling || autotiling` guard SELF-MATCHES the sh running it (that
# cmdline contains the path), so it would never launch on a fresh login.
exec autotiling

# Polkit agent — REQUIRED. Without it GUI privilege prompts silently fail.
# On Debian the path is /usr/libexec/, NOT /usr/lib/mate-polkit/. Confirm on
# another distro with:  dpkg -L mate-polkit | grep authentication-agent
# No lxpolkit fallback — a fallback to an uninstalled binary just masks a failure.
exec /usr/libexec/polkit-mate-authentication-agent-1

# Tray applets.
#
# Keep this exec even though waybar no longer shows a tray (see the "tray"
# block in config/waybar/config). nm-applet's real job here is being
# NetworkManager's secret agent — the thing that prompts for a wifi password
# when you join a new network — which it does over D-Bus with or without a
# visible icon. Removing the line would silently stop those prompts.
# Note that neither dropping --indicator nor
# `gsettings set org.gnome.nm-applet show-applet false` suppresses its
# StatusNotifier item; both still register it as Active.
exec nm-applet --indicator
exec blueman-applet

# Hand the session env to the portals / systemd user units.
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Dark appearance for GTK4/libadwaita apps.
#
# ⚠ THIS IS THE HALF THAT config/gtk/*-settings.ini CANNOT DO, and both halves
# are needed. libadwaita ignores settings.ini for light/dark entirely: it asks
# the xdg-desktop-portal Settings interface for org.freedesktop.appearance
# color-scheme. Under sway that interface is served by xdg-desktop-portal-gtk
# (routed explicitly in config/sway/sway-portals.conf), and the GTK backend
# answers it by reading exactly this GSettings key. So without this line a
# libadwaita app opens light no matter what the ini files say. GTK3 apps are the
# reverse case — they read the ini and ignore this. Hence one of each.
#
# ⚠ GSettings IS USER-GLOBAL, NOT SESSION-SCOPED — this is the one thing in this
# file that outlives the sway session. It writes to dconf, so GNOME picks up the
# same preference on the next login and stays dark until something changes it
# back. That is a deliberate accepted side effect (a dark GNOME is wanted too),
# but it does mean this is NOT of a piece with sway-portals.conf, which really is
# sway-only. Undo with:
#     gsettings set org.gnome.desktop.interface color-scheme 'default'
#
# exec_always, not exec: cheap, idempotent, and it re-asserts the value after
# anything else (a GNOME login, a stray `gsettings reset`) has changed it.
exec_always gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# swaybar is replaced by waybar; keep this empty block out of the config
# rather than defining an unused `bar {}`.

include /etc/sway/config.d/*
