# sway config — managed by dfinstall (modules/sway.go), linked to ~/.config/sway/config
#
# ############################################################################
# #  RULE 1: $mod IS Mod4 (Super). THERE ARE NO Alt (Mod1) BINDINGS HERE.    #
# #                                                                          #
# #  tmux owns the entire Alt keyspace on this box: prefix M-a, plus         #
# #  no-prefix binds on M-1..M-9, M-n, M-Enter, M--, M-q, M-m, M-s, M-c.    #
# #  sway grabs keys BEFORE the terminal sees them, so any Alt binding here  #
# #  silently steals a tmux binding. Do not add one. Ever.                   #
# ############################################################################
#
# Validate before logging in — a broken config leaves you at a black screen:
#   sway --validate -c config/sway/config
# Off a graphical session that needs a backend hint:
#   env WLR_BACKENDS=headless sway --validate -c config/sway/config

set $mod Mod4
set $left  h
set $down  j
set $up    k
set $right l

set $term    ghostty
set $menu    fuzzel
set $lock    swaylock -f -c 1e1e2e

### Appearance -------------------------------------------------------------
font pango:Hack 10

# Titlebars stay ON — this is a deliberate mouse-friendliness choice, not an
# oversight. Set `default_border pixel 2` + `titlebar` off if you change your mind.
default_border          normal 2
default_floating_border normal 2
gaps inner 4
smart_gaps on

# Reuse the old dwm-era wallpaper; confirm with owen before changing.
# Absolute path deliberately — do not rely on `~` expansion in sway directives.
output * bg /home/owen/.config/background fill

### Outputs ----------------------------------------------------------------
# Laptop panel. Intel Iris Xe (Alder Lake-P), i915.
output eDP-1 resolution 1920x1080 position 0,0
# Externals on the Intel GPU. DisplayLink/evdi outputs (DVI-I-*) are a separate
# problem — see PLAN.md Phase 0. Add them here only once they enumerate.
# output HDMI-A-1 position 1920,0

### Input ------------------------------------------------------------------
# "Don't reject the mouse": click-to-focus, not follow-mouse.
focus_follows_mouse no
mouse_warping      output

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    scroll_factor 0.6
}

input type:keyboard {
    xkb_layout us
    repeat_delay 250
    repeat_rate 40
}

# $mod + drag to move, $mod + right-drag to resize.
floating_modifier $mod normal

### Launchers --------------------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+d      exec $menu
bindsym $mod+e      exec nautilus
bindsym $mod+Shift+q kill

### Focus / movement -------------------------------------------------------
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

### Workspaces -------------------------------------------------------------
# Super+1..9 — safe, since tmux's window switching is Alt+1..9.
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

### Layout ----------------------------------------------------------------
bindsym $mod+b           splith
bindsym $mod+v           splitv
bindsym $mod+s           layout stacking
bindsym $mod+w           layout tabbed
bindsym $mod+t           layout toggle split
bindsym $mod+f           fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space       focus mode_toggle
bindsym $mod+a           focus parent

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

mode "resize" {
    bindsym $left  resize shrink width  10px
    bindsym $down  resize grow   height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow   width  10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Session ---------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+x exec $lock

### Media / laptop keys ---------------------------------------------------
bindsym --locked XF86AudioRaiseVolume  exec wpctl set-volume  @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume  exec wpctl set-volume  @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute         exec wpctl set-mute    @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute      exec wpctl set-mute    @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86AudioPlay         exec playerctl play-pause
bindsym --locked XF86AudioNext         exec playerctl next
bindsym --locked XF86AudioPrev         exec playerctl previous

### Screenshots -----------------------------------------------------------
bindsym Print       exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy

### Window rules ----------------------------------------------------------
# Float dialogs rather than tiling them — mouse-friendliness again.
for_window [window_role="dialog"]        floating enable
for_window [window_role="pop-up"]        floating enable
for_window [window_type="dialog"]        floating enable
for_window [app_id="pavucontrol"]        floating enable
for_window [app_id="blueman-manager"]    floating enable
for_window [app_id="nm-connection-editor"] floating enable

### Idle / lock -----------------------------------------------------------
exec swayidle -w \
    timeout 600  "$lock" \
    timeout 900  'swaymsg "output * power off"' \
        resume   'swaymsg "output * power on"' \
    before-sleep "$lock"

# Lid close → lock (not suspend; logind still handles suspend policy).
bindswitch --reload --locked lid:on exec $lock

### Autostart ------------------------------------------------------------
# Reload-SAFE autostart. Do NOT go back to the old pattern of a separate
# `exec_always pkill -x <app>` line followed by `exec_always <app>`: sway forks
# exec lines ASYNCHRONOUSLY, so the pkill races the launch and kills the
# just-started instance. Verified 2026-08-01 on this box: that pattern dropped
# waybar+mako on EVERY `swaymsg reload` and intermittently on fresh login (it is
# what made phase5-checks report waybar/mako FAIL). Merging into one
# `pkill -x waybar; waybar` does NOT fix it either — killing waybar and
# relaunching within one command loses the bar at any delay (0/0.5/1s all tested)
# on this DisplayLink primary-GPU-scanout setup. The rule that works: reload the
# RUNNING instance in place, and only spawn one if none is running. Never
# kill-and-respawn. (`||` and `>` below are handled by sh -c, not sway's parser.)
exec_always pkill -SIGUSR2 -x waybar || waybar     # waybar reloads its config on SIGUSR2
exec_always makoctl reload || mako                 # mako reloads via makoctl, else start

# Dynamic-tiling approximation over sway IPC — the mitigation for sway being
# manual-tiling. Comment this out to judge plain sway first (PLAN.md open Q 5).
# Plain `exec` (NOT exec_always): start one autotiling at login and leave it.
# It has no config to reload, so re-running it on every `swaymsg reload` only
# leaked duplicates. Two dead-ends that look tempting: `exec_always pkill -x
# autotiling; autotiling` never matches (it runs as comm `python3`, so it also
# made phase5's `pgrep -x autotiling` a FALSE FAIL), and a `pgrep -f
# /usr/bin/autotiling || autotiling` guard SELF-MATCHES the sh running it (that
# cmdline contains the path), so it would never launch on a fresh login.
exec autotiling

# Polkit agent — REQUIRED. Without it GUI privilege prompts silently fail.
# Path VERIFIED 2026-07-27 on this box via `dpkg -L mate-polkit | grep authentication-agent`:
# it is /usr/libexec/, NOT /usr/lib/mate-polkit/ as an earlier draft comment claimed.
# No lxpolkit fallback — lxpolkit is not installed, so a fallback would just mask a failure.
exec /usr/libexec/polkit-mate-authentication-agent-1

# Tray applets — installed 2026-07-27 (PLAN.md open Q 4: owen chose both).
exec nm-applet --indicator
exec blueman-applet

# Hand the session env to the portals / systemd user units.
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# swaybar is replaced by waybar; keep this empty block out of the config
# rather than defining an unused `bar {}`.

include /etc/sway/config.d/*
