+        /**
+         * LOCAL DELTA — separates "cover the panel's own output" from "cover
+         * every other output". Upstream's layer_shell_cover_screen does both
+         * at once: it full-bleeds the ControlCenter surface on the panel's
+         * output (which is what makes click-outside-to-dismiss work) AND it
+         * spawns a BlankWindow layer-shell surface on every OTHER connected
+         * output to catch clicks and dismiss the panel from anywhere.
+         *
+         * On a single-output setup that is fine. On a multi-monitor setup
+         * those blank windows sit on top of the other outputs' waybars and
+         * eat the first click on any bar that is not the panel's — the
+         * click dismisses swaync instead of doing what the user aimed at.
+         *
+         * Setting this to false skips creating the blank windows entirely,
+         * so waybar on the other outputs stays clickable while the panel is
+         * open. The panel's own output still full-bleeds (via
+         * layer_shell_cover_screen) so click-outside there still dismisses.
+         *
+         * Defaults to true for backward compatibility with the upstream
+         * behavior — a fresh swaync install should behave the same as before.
+         */
+        public bool layer_shell_cover_other_outputs { get; set; default = true; }
