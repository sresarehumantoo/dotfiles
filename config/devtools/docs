#!/usr/bin/env bash
# docs — read offline usage docs: dfinstall's own, and the sets fetched by
# `dfinstall install docs`
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

root="$HOME/.local/share/dfinstall/docs"

usage() {
    cat <<'EOF'
Usage: docs                    list the doc sets
       docs SET                pick a topic (fzf), or list every topic
       docs SET TOPIC          open a topic: argparse, argparse.Action, ci/yaml
                               (dfinstall: any heading in its docs, e.g. docs)
       docs -s SET PATTERN     list the pages whose text matches PATTERN

TOPIC matches an index name exactly, then case-insensitively, then as a
prefix. Several prefix matches go to fzf when it is available.

The dfinstall set is read live from the dotfiles checkout's README.md and
docs/, so it needs no fetching and follows the checkout. Other sets come from
the doc_sets list in ~/.config/dfinstall/config.yaml (DevDocs
slugs such as python~3.13, or gitlab); `dfinstall install docs` fetches them
and `dfinstall update docs` refreshes them.
EOF
}

tmp="" dfindex=""
cleanup() {
    [[ -z "$tmp" ]] || rm -f "$tmp"
    [[ -z "$dfindex" ]] || rm -f "$dfindex"
}
trap cleanup EXIT

checkout() {
    local d=${DOTFILES:-}
    [[ -n "$d" ]] || d=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/dfinstall/dotfiles-dir" 2>/dev/null) || true
    [[ -n "$d" && -f "$d/README.md" && -d "$d/docs" ]] || return 1
    printf '%s' "$d"
}

# One entry per markdown file and per heading in it, pointing at its line.
# Headings inside code fences are shell comments, not sections.
dfinstall_index() {
    (cd "$1" && find README.md docs -path docs/nvim-tutorial/vault -prune -o -name '*.md' \
        -exec awk '
            FNR == 1 { fence = 0; n = FILENAME; sub(/^docs\//, "", n); sub(/\.md$/, "", n)
                       print n "\t" FILENAME "\t" FILENAME }
            /^(```|~~~)/ { fence = !fence; next }
            !fence && /^#+ / { h = $0; sub(/^#+ +/, "", h); gsub(/[`*]/, "", h)
                               print h "\t" FILENAME "#L" FNR "\t" FILENAME }' {} +)
}

list_sets() {
    local d co
    if co=$(checkout); then
        printf '%-14s %s\n' dfinstall "$co"
    elif [[ ! -d "$root" ]]; then
        die "no docs fetched yet: run \`dfinstall install docs\`"
    fi
    for d in "$root"/*/; do
        [[ -d "$d" ]] || continue
        [[ -f "$d.source" ]] || continue
        printf '%-14s %s\n' "$(basename "$d")" "$(cut -d' ' -f2- "$d.source")"
    done
}

# Sets the globals dir (where the pages are) and index for SET.
use_set() {
    if [[ "$1" == dfinstall ]]; then
        dir=$(checkout) || die "no dotfiles checkout recorded: run \`dfinstall init\`"
        dfindex=$(mktemp "${TMPDIR:-/tmp}/docs-index.XXXXXX")
        dfinstall_index "$dir" >"$dfindex"
        index=$dfindex
        return
    fi
    dir="$root/$1" index="$root/$1/index.tsv"
    [[ "$1" != */* && -f "$index" ]] \
        || die "no doc set '$1' (have: $(list_sets | cut -d' ' -f1 | paste -sd' ' -))"
}

pick() {
    if command -v fzf &>/dev/null && [[ -t 2 ]]; then
        fzf --delimiter '\t' --with-nth 1,3 --select-1 --exit-0 | cut -f2
    else
        cut -f1 >&2
        return 1
    fi
}

# Prints the index path ("page[#anchor]") for TOPIC.
lookup() {
    local topic="$1" lower="" hit
    hit=$(awk -F'\t' -v t="$topic" '$1 == t || $2 == t { print $2; exit }' "$index")
    if [[ -z "$hit" ]]; then
        lower=$(printf '%s' "$topic" | tr '[:upper:]' '[:lower:]')
        hit=$(awk -F'\t' -v t="$lower" 'tolower($1) == t { print $2; exit }' "$index")
    fi
    if [[ -z "$hit" ]]; then
        local matches
        matches=$(awk -F'\t' -v t="$lower" 'index(tolower($1), t) == 1' "$index")
        [[ -n "$matches" ]] || die "no topic '$topic' in $set"
        if [[ $(printf '%s\n' "$matches" | wc -l) -eq 1 ]]; then
            hit=$(printf '%s\n' "$matches" | cut -f2)
        else
            hit=$(printf '%s\n' "$matches" | pick) || die "'$topic' is ambiguous, matches above"
        fi
    fi
    printf '%s' "$hit"
}

# A fixed width would overflow panes narrower than it, so cap at the pane width.
width() {
    local w=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
    echo $(( w < 80 ? w : 80 ))
}

# show TEXT_FILE LINE FILETYPE
show() {
    if command -v nvim &>/dev/null; then
        nvim -R +"$2" \
            -c "setlocal nomodifiable nomodified noswapfile filetype=$3" \
            -c 'nnoremap <buffer> q <cmd>quit<CR>' "$1"
    else
        less -R +"$2"g "$1"
    fi
}

# DevDocs pages are HTML, rendered here with w3m. The anchor is lost in the
# rendering, so a marker is planted after the anchored tag and found again in
# the text to pick the line to open at.
open_html() {
    local file="$1" anchor="$2" out="$3" mark="@@DOCS-ANCHOR@@" line=1 n
    command -v w3m &>/dev/null || die "w3m is needed to render DevDocs pages"
    awk -v id="id=\"$anchor\"" -v m="$mark" '
        !done && id != "id=\"\"" && (i = index($0, id)) {
            j = index(substr($0, i), ">")
            if (j) { $0 = substr($0, 1, i + j - 1) m substr($0, i + j); done = 1 }
        }
        { print }' "$file" \
        | w3m -dump -T text/html -O UTF-8 -cols "$(width)" >"$out"
    if n=$(grep -n -m1 -F "$mark" "$out"); then
        line=${n%%:*}
        sed -i.bak "s/$mark//" "$out" && rm -f "$out.bak"
    fi
    show "$out" "$line" text
}

open_topic() {
    local hit="$1" page anchor="" line=1
    page=${hit%%#*}
    [[ "$hit" == *#* ]] && anchor=${hit#*#}
    if [[ "$page" == *.md ]]; then
        [[ "$anchor" =~ ^L[0-9]+$ ]] && line=${anchor#L}
        show "$dir/$page" "$line" markdown
        return
    fi
    tmp=$(mktemp "${TMPDIR:-/tmp}/docs.XXXXXX")
    open_html "$dir/$page.html" "$anchor" "$tmp"
}

search() {
    use_set "$1"
    if [[ "$1" == dfinstall ]]; then
        (cd "$dir" && grep -rliI --include='*.md' --exclude-dir=vault -e "$2" README.md docs | sort)
        return
    fi
    (cd "$dir" && grep -rliI --exclude=index.tsv --exclude=.source -e "$2" . \
        | sed -e 's|^\./||' -e 's|\.html$||' | sort)
}

case "${1:-}" in
    -h|--help) usage ;;
    "") list_sets ;;
    -s)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        search "$2" "$3"
        ;;
    -*) usage >&2; exit 2 ;;
    *)
        set=$1
        use_set "$set"
        if [[ $# -eq 1 ]]; then
            if ! command -v fzf &>/dev/null || [[ ! -t 0 || ! -t 1 ]]; then
                cut -f1 "$index"
                exit 0
            fi
            hit=$(pick <"$index")
            [[ -n "$hit" ]] || exit 0
        else
            hit=$(lookup "$2")
        fi
        open_topic "$hit"
        ;;
esac
