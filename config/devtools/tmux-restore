#!/usr/bin/env bash
# Toggle tmux session auto-restore (continuum + resurrect).
#
# Auto-restore is ON by default: a new tmux server restores the last save
# within its first seconds. `off` creates the marker file tmux.conf checks
# to opt out. The change applies the next time the tmux server starts.
#
# Manual restore is always available inside tmux via: prefix + Ctrl-r
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

MARKER="$HOME/.config/tmux/restore-off"
# The opt-in marker from when auto-restore defaulted to off. Nothing reads it
# now, so any run removes it.
rm -f "$HOME/.config/tmux/restore-on"

usage() {
    header "tmux-restore"
    echo "Usage: tmux-restore [on|off|status|toggle]"
    echo ""
    echo "  on       Enable auto-restore at next tmux server start (default)."
    echo "  off      Disable auto-restore."
    echo "  toggle   Flip whichever way it's currently set."
    echo "  status   Show current state and the marker path."
    echo ""
    echo "Marker file: $MARKER"
    echo "Reload tmux config to apply to a running session:"
    echo "  tmux source-file ~/.tmux.conf"
    echo "(@continuum-restore is only consulted at server start, so the"
    echo " full effect lands the next time tmux is launched fresh.)"
}

current_state() {
    [[ -f "$MARKER" ]] && echo "off" || echo "on"
}

case "${1:-status}" in
    -h|--help)
        usage
        ;;
    on)
        rm -f "$MARKER"
        ok "Auto-restore: ON  (marker removed)"
        info "Effect lands at the next tmux server start."
        ;;
    off)
        mkdir -p "$(dirname "$MARKER")"
        : > "$MARKER"
        ok "Auto-restore: OFF  (marker: $MARKER)"
        info "Effect lands at the next tmux server start."
        ;;
    toggle)
        if [[ -f "$MARKER" ]]; then
            "$0" on
        else
            "$0" off
        fi
        ;;
    status)
        state="$(current_state)"
        info "Auto-restore: $state"
        info "Marker: $MARKER"
        # shellcheck disable=SC2033  # 'tmux info' is the tmux subcommand, not the info() helper from _lib.sh
        if command -v tmux &>/dev/null && tmux info &>/dev/null; then
            running="$(tmux show-options -gv @continuum-restore 2>/dev/null || echo unset)"
            info "Running tmux server reports @continuum-restore: $running"
            if [[ "$state" != "$running" ]]; then
                warn "Mismatch — reload config or restart the tmux server to sync."
            fi
        fi
        ;;
    *)
        err "Unknown command: $1"
        usage
        exit 2
        ;;
esac
