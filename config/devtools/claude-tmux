#!/usr/bin/env bash
# Bring Claude Code conversations back when tmux-resurrect restores a server.
#
# Resurrect saves each pane's command line, but that never carries a session
# id: a pane saved as `claude --resume` reopens the picker and one saved as
# `claude` starts empty. This keeps the missing mapping:
#
#   record  Claude Code SessionStart hook: tag the pane with its session id
#   save    resurrect post-save-all hook: write pane position -> session id
#   resume  what resurrect runs in a restored pane that was running claude
#
# The id lives on the pane (an option that follows the pane through
# renumber-windows) and is only turned into a position at save time, because
# position is the one key a restore preserves.
set -euo pipefail

MAP="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tmux/panes"

usage() {
    echo "Usage: claude-tmux record|save|resume"
    echo ""
    echo "  record   Read SessionStart hook JSON on stdin, tag \$TMUX_PANE with its session id."
    echo "  save     Write every tagged pane's position and session id to the map."
    echo "  resume   Resume the conversation this pane held at the last save. Without"
    echo "           one, the latest in this directory (claude --continue) if no other"
    echo "           claude pane was there, else the picker (claude --resume)."
    echo ""
    echo "Map: $MAP"
}

record() {
    [[ -n "${TMUX_PANE:-}" ]] || return 0
    local id
    id=$(grep -o '"session_id"[[:space:]]*:[[:space:]]*"[A-Za-z0-9-]*"' | head -n 1 | sed 's/.*"\([A-Za-z0-9-]*\)"$/\1/') || true
    [[ -n "$id" ]] || return 0
    # SessionStart stdout is added to the conversation's context, so stay silent.
    tmux set-option -p -t "$TMUX_PANE" @claude-session "$id" >/dev/null
}

# Untagged claude panes are kept too, with an empty id: resume needs to know
# which panes shared a directory even when it cannot know their conversations.
save() {
    mkdir -p "${MAP%/*}"
    local tmp
    tmp=$(mktemp "$MAP.XXXXXX")
    tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}"$'\t'"#{@claude-session}"$'\t'"#{pane_current_path}"$'\t'"#{pane_current_command}" |
        awk -F'\t' -v OFS='\t' '$2 != "" || $4 == "claude" { print $1, $2, $3 }' >"$tmp"
    mv -f "$tmp" "$MAP"
}

resume() {
    local key entry id dir here siblings
    key=$(tmux display-message -p -t "${TMUX_PANE:?not inside tmux}" '#{session_name}:#{window_index}.#{pane_index}')
    here=$(pwd -P)
    entry=$( (awk -F'\t' -v k="$key" '$1 == k' "$MAP" | head -n 1) 2>/dev/null || true)
    # cut, not read: tab is IFS whitespace, so read collapses an empty id field.
    id=$(cut -f2 <<<"$entry")
    dir=$(cut -f3 <<<"$entry")
    # Resurrect reopens the pane in the directory it saved, so a different one
    # means the map and the restored save disagree about this pane.
    if [[ -n "$entry" && "$dir" == "$here" ]]; then
        if [[ -n "$id" ]]; then
            # Tag now: a save before SessionStart fires would otherwise drop it.
            tmux set-option -p -t "$TMUX_PANE" @claude-session "$id"
            exec claude --resume "$id"
        fi
        siblings=$(awk -F'\t' -v k="$key" -v d="$here" '$1 != k && $3 == d' "$MAP" | wc -l)
        # --continue opens the latest conversation in this directory, which is
        # only this pane's when no other claude pane was working here.
        ((siblings == 0)) && exec claude --continue
    fi
    exec claude --resume
}

case "${1:-}" in
    record) record ;;
    save) save ;;
    resume) resume ;;
    -h|--help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
