#!/usr/bin/env bash
# jwt-decode: print a JWT's header and payload, with its time claims readable.
set -euo pipefail

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<'EOF'
Usage: jwt-decode [TOKEN]
       command | jwt-decode

Decodes a JWT and pretty-prints its header and payload. The iat, nbf and exp
claims are shown as local times, with whether the token is expired or not yet
valid. A leading "Bearer " and surrounding whitespace are ignored.

The signature is NOT verified: this shows what a token claims, not whether
those claims can be trusted.

With no TOKEN, reads it from stdin, so it never has to appear in shell history:
  wl-paste | jwt-decode
  jwt-decode < token.txt
EOF
  exit 0
fi

if [[ $# -gt 0 ]]; then
  token=$1
else
  [[ -t 0 ]] && echo "Paste the token, then Ctrl-D:" >&2
  token=$(cat)
fi

color=0
[[ -t 1 ]] && color=1

perl -MMIME::Base64 -MJSON::PP -MPOSIX=strftime -e '
  my ($token, $color) = @ARGV;
  my ($bold, $dim, $red, $green, $yellow, $reset) =
    $color ? ("\e[1m", "\e[2m", "\e[31m", "\e[32m", "\e[33m", "\e[0m") : ("") x 6;

  $token =~ s/^\s+|\s+$//g;
  $token =~ s/^Bearer\s+//i;
  my @parts = split /\./, $token, -1;
  if (@parts == 5) { die "jwt-decode: this is an encrypted JWT (JWE); its payload cannot be read without the key\n" }
  if (@parts != 3) { die "jwt-decode: expected 3 dot-separated parts, got " . scalar(@parts) . "\n" }

  my $json = JSON::PP->new->pretty->indent_length(2)->canonical->allow_nonref;
  sub part {
    my ($name, $b64) = @_;
    (my $s = $b64) =~ tr{-_}{+/};
    $s .= "=" x ((4 - length($s) % 4) % 4);
    my $raw = decode_base64($s);
    my $data = eval { JSON::PP->new->decode($raw) };
    die "jwt-decode: the $name is not valid JSON\n" unless defined $data;
    return $data;
  }
  my $header  = part("header",  $parts[0]);
  my $payload = part("payload", $parts[1]);

  print "${bold}Header${reset}\n",  $json->encode($header);
  print "${bold}Payload${reset}\n", $json->encode($payload);

  sub ago {
    my $d = abs(shift);
    return "${d}s" if $d < 60;
    return int($d / 60) . "m" if $d < 3600;
    return sprintf("%dh%02dm", $d / 3600, ($d % 3600) / 60) if $d < 86400;
    return sprintf("%dd%02dh", $d / 86400, ($d % 86400) / 3600);
  }

  my $now = time;
  my @times = ref $payload ne "HASH" ? () :
    grep { defined $payload->{$_} && !ref $payload->{$_} && $payload->{$_} =~ /^\d+(\.\d+)?$/ } qw(iat nbf exp);
  if (@times) {
    print "${bold}Times${reset}\n";
    for my $k (@times) {
      my $t = int $payload->{$k};
      my $when = strftime("%Y-%m-%d %H:%M:%S %Z", localtime $t);
      my $rel = $t > $now ? "in " . ago($t - $now) : ago($now - $t) . " ago";
      my $note = "";
      if    ($k eq "exp") { $note = $t <= $now ? "  ${red}EXPIRED${reset}" : "  ${green}valid${reset}" }
      elsif ($k eq "nbf" && $t > $now) { $note = "  ${yellow}NOT YET VALID${reset}" }
      printf "  %-3s  %s  ${dim}(%s)${reset}%s\n", $k, $when, $rel, $note;
    }
  }

  my $alg = ref $header eq "HASH" ? ($header->{alg} // "?") : "?";
  my $sig = $alg eq "none" || $parts[2] eq "" ? "${red}unsigned${reset}" : "present, NOT verified";
  print "${bold}Signature${reset}\n  alg $alg, $sig\n";
' "$token" "$color"
