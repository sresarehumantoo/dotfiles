#!/usr/bin/env bash
# Claude Code PreToolUse hook (claude module): refuses a Bash command that
# runs git or gh with AI attribution in it (an assistant's Co-authored-by
# trailer, "Generated with ...", a Claude session link), before it runs.
#
# The git and gh wrappers strip attribution too, but only from the git and gh
# that actually run them; a repository with its own core.hooksPath and a git
# found ahead of the wrapper both get past them. This works whichever runs.
#
# Reads the hook's JSON on stdin. Exit 2 refuses the call and shows Claude the
# message on stderr; anything else lets it run. Runs on macOS's /bin/bash 3.2.
set -uo pipefail

case "${1:-}" in
    -h | --help)
        sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

# shellcheck source=_scrub.sh
. "${BASH_SOURCE[0]%/*}/_scrub.sh"

# The command arrives as one JSON string, its line breaks escaped as \n, so
# nothing here is anchored to a line start; [^"]* keeps a match inside it.
awk -v ai="$_scrub_ai" '
    {
        l = tolower($0)
        if (l !~ /(^|[^a-z0-9_-])(git|gh)[ \t]/) next
        if (l ~ ("co-authored-by:[^\"]*(" ai ")") ||
            l ~ ("generated (with|by|using) [^\"]*(" ai ")") ||
            l ~ /claude-session:/ || l ~ /claude\.ai\/code\/session/) found = 1
    }
    END { exit !found }' || exit 0

cat >&2 <<'EOF'
Refused: this command writes AI attribution into git or GitHub (an assistant's
Co-authored-by trailer, a "Generated with" line, or a Claude session link).
Run it again without that text. Do not work around this check.
EOF
exit 2
