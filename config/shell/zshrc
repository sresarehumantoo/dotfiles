# ---- tmux auto-start ---------------------------------------------------------
# Interactive shells land in tmux. `-A` attaches to `main` if it exists and
# creates it otherwise, so every terminal shares one session.
#
# ESCAPE HATCH: DF_NO_TMUX=1 gives a plain shell.
#
#     DF_NO_TMUX=1 ghostty      # one terminal, no tmux
#     export DF_NO_TMUX=1       # ...and anything it launches
#
# Empty or 0 means "start tmux", anything else means "don't". The name is
# negative, so requiring the value 1 to mean *no* tmux is the only reading that
# is not a coin flip at the prompt. Naming follows DF_SMEAR_CURSOR.
#
# There was no opt-out at all before this, and that is what made the whole thing
# hard to live with: the only reliable way to a tmux-free shell was to run
# `bash`. `TERM=dumb zsh` also worked, but by accident, and it drags the prompt
# down to robbyrussell (see the P10k guard below), drops the cursor-shape
# keybinds and un-colors tldr, which is a lot of collateral for "just give me
# a shell this once".
#
# NOT `exec`, AND THAT IS THE POINT. `exec tmux ...` replaces the shell, leaving
# nothing underneath it, which caused three separate complaints that never
# looked related:
#   - detaching (prefix d) CLOSED THE TERMINAL rather than dropping to a prompt,
#     so detach was not an escape hatch either;
#   - a tmux that failed to start (stale socket after a WSL VM restart, a
#     tmux.conf you just broke, /tmp not writable) took the window down with
#     it before the error could be read, so the failure was invisible;
#   - there was no way to `exit` back to a plain shell.
# Calling it normally costs one idle parent zsh (a few MB) for the length of the
# session and buys back all three. The `exit` below preserves the old behaviour
# where detaching ends the terminal.
if [[ -z "$DF_NO_TMUX" || "$DF_NO_TMUX" == 0 ]] \
  && command -v tmux &>/dev/null \
  && [[ -z "$TMUX" ]] \
  && [[ $- == *i* ]] \
  && [[ "$TERM" != "linux" ]] \
  && [[ "$TERM" != "dumb" ]] \
  && [[ "$TERM_PROGRAM" != "vscode" ]] \
  && [[ "$TERMINAL_EMULATOR" != "JetBrains-JediTerm" ]] \
  && [[ -z "$INTELLIJ_ENVIRONMENT_READER" ]]; then
  # TERM_PROGRAM is the VS Code check that works, and it covers Cursor and
  # Windsurf too. `VSCODE_PID` used to be in this list and guarded nothing: it
  # is set for the extension-host process, not for the integrated terminal.
  #
  # TERMINAL_EMULATOR is the JetBrains check that works.
  # `INTELLIJ_ENVIRONMENT_READER` is set only during JetBrains' one-shot
  # env-probe shell and never in the terminal you type into, so until that
  # line was added, IntelliJ terminals were exec'd into tmux like any other.
  tmux new-session -A -s main
  tmux_rc=$?
  if (( tmux_rc == 0 )); then
    # Normal end: the session was detached or its last window closed. Match the
    # old behaviour and take the terminal with it.
    exit
  fi
  print -u2 "tmux exited $tmux_rc; continuing in a plain shell."
  print -u2 "(DF_NO_TMUX=1 skips tmux entirely.)"
  unset tmux_rc
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_DISABLE_COMPFIX=true

# Disable OMZ "magic functions" (url-quote-magic / bracketed-paste-magic).
# url-quote-magic backslash-escapes shell metacharacters (| ? & ~ =) after a
# pasted URL, mangling e.g. `curl https://x/install | sudo bash` into `...\|...`.
# Native zsh bracketed-paste still protects multi-line pastes. Must be set
# before oh-my-zsh.sh is sourced. See lib/misc.zsh.
DISABLE_MAGIC_FUNCTIONS=true

# Source extended plugins (generated by dfinstall --extended)
[[ -f ~/.config/dfinstall/plugins.zsh ]] && source ~/.config/dfinstall/plugins.zsh

plugins=(
git
zsh-autosuggestions
docker
terraform
fzf
golang
${DFINSTALL_EXTENDED_PLUGINS[@]}
)

# P10k and themed prompt — skip on raw TTY / dumb terminal
if [[ "$TERM" != "linux" && "$TERM" != "dumb" ]]; then
  # Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
  if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  fi

  ZSH_THEME="powerlevel10k/powerlevel10k"
  if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
    [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
  else
    print -P "%F{yellow} Oh My Zsh not installed at $ZSH%f"
    print -P "%F{yellow}  run: dfinstall install omz%f"
  fi
else
  # Minimal ASCII-safe prompt for raw TTY
  ZSH_THEME="robbyrussell"
  [[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"
fi

# Source modular config from ~/.zsh.d/
for f in ~/.zsh.d/*.zsh(N); do source "$f"; done

# Source aliases
[[ -f ~/.aliases ]] && source ~/.aliases

# Source preserved custom shell files (generated by dfinstall)
[[ -f ~/.config/dfinstall/custom-sources.zsh ]] && source ~/.config/dfinstall/custom-sources.zsh

# Source Windows cross-dev PATH (generated by dfinstall install windev)
[[ -f ~/.config/dfinstall/windev.zsh ]] && source ~/.config/dfinstall/windev.zsh

# Syntax highlighting
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
