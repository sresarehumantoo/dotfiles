# Doas → sudo (only if doas is installed)
command -v doas &>/dev/null && alias sudo="doas"

# Package management (apt-get only if available)
if command -v apt-get &>/dev/null; then
  alias update="sudo apt-get update"
  alias upgrade="sudo apt-get upgrade"
  alias updateDist="sudo apt-get dist-upgrade"
  alias updateAll="sudo apt-get update && sudo apt-get upgrade && sudo apt-get dist-upgrade"
fi

# Clipboard (detect xclip vs wl-copy)
# xclip/wl-copy handle multiline content natively via the selection flag —
# the previous `tr '\n' '\0'` step was mangling newlines into NUL bytes.
if command -v wl-copy &>/dev/null; then
  alias clip="wl-copy"
elif command -v xclip &>/dev/null; then
  alias clip="xclip -selection clipboard"
elif command -v xsel &>/dev/null; then
  alias clip="xsel --clipboard --input"
fi

# Terminal recording (asciinema) → GIF (agg)
# `asciinema rec` with no filename records to a temp file and then offers
# (s)ave/(u)pload/(d)iscard, where `u` publishes to asciinema.org — one keystroke
# away from putting a session's target IPs, creds and flags on the public web
# (and -y/-q skips the prompt and uploads outright). So a bare `record` saves to
# a local timestamped file instead. Pass a filename to choose your own; flags
# alone still get the local default, since a flag is not a filename.
if command -v asciinema &>/dev/null; then
  record() {
    # Only a positional arg is a filename — testing `$#` would let `record -c cmd`
    # through to the upload prompt, which is the exact case this guards against.
    # The listed flags take a value, so skip the token after them.
    local arg has_file=0 skip=0
    for arg in "$@"; do
      if (( skip )); then skip=0; continue; fi
      case "$arg" in
        -c|--command|-e|--env|-t|--title|-i|--idle-time-limit|--cols|--rows) skip=1 ;;
        -) has_file=1 ;;   # explicit "record to stdout"
        -*) ;;
        *) has_file=1 ;;
      esac
    done

    if (( has_file )); then
      asciinema rec "$@"
    else
      local dir="${XDG_DATA_HOME:-$HOME/.local/share}/asciinema"
      mkdir -p "$dir" || return 1
      # Two recordings in the same second would otherwise collide, and asciinema
      # aborts on an existing non-empty file rather than overwriting — safe for
      # the old cast, but it throws away the one just recorded.
      local base="$dir/$(date +%Y%m%d-%H%M%S)" file n=1
      file="$base.cast"
      while [[ -e "$file" ]]; do file="$base-$((n++)).cast"; done
      asciinema rec "$@" "$file"
    fi
  }
fi

# agg re-renders the *text* of a cast, so it picks its own font rather than the
# terminal's. Do NOT point it at the Ghostty font ("Hack Nerd Font"): agg
# measures glyph advances itself and rejects the patched Nerd variants with
#   [WARN agg] first font family "Hack Nerd Font" is not monospaced;
#              terminal cell metrics may be incorrect
# and then renders overlapping cells — a command and its output run together on
# one line. fontconfig disagrees (it reports spacing=100), so this is only
# visible in agg's own warning, on stderr.
#
# agg's default list already resolves to a real monospace face and still renders
# Nerd Font glyphs through fallback, so no --font-family is the correct answer.
# --font-size is omitted for a duller reason: agg's default is already 16.
if command -v agg &>/dev/null; then
  alias render="agg"
fi

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ll="ls -lAh"
alias la="ls -A"

# General
alias q="exit"
alias vim='nvim'
alias python="python3"
alias docker-compose="docker compose"

# Quick config editing
alias zshrc="$EDITOR ~/.zshrc"
alias vimrc="$EDITOR ~/.config/nvim/init.lua"
alias tmuxrc="$EDITOR ~/.config/tmux/tmux.conf"

# Debian binary corrections (bat/fd install under different names)
command -v batcat &>/dev/null && ! command -v bat &>/dev/null && alias bat="batcat"
command -v fdfind &>/dev/null && ! command -v fd &>/dev/null && alias fd="fdfind"

# Docker
alias dps="docker ps"
alias dimg="docker images"
alias dlog="docker logs -f"
alias dex="docker exec -it"
alias dcp="docker compose"
alias dcup="docker compose up -d"
alias dcdn="docker compose down"

# Terraform
alias tf="terraform"
alias tfi="terraform init"
alias tfp="terraform plan"
alias tfa="terraform apply"

# Tmux logging (requires tmux-logging plugin)
alias tlog="tmux run-shell ~/.tmux/plugins/tmux-logging/scripts/toggle_logging.sh"
alias tcap="tmux run-shell ~/.tmux/plugins/tmux-logging/scripts/screen_capture.sh"
alias thist="tmux run-shell ~/.tmux/plugins/tmux-logging/scripts/save_complete_history.sh"
alias tclear="tmux run-shell ~/.tmux/plugins/tmux-logging/scripts/clear_history.sh"

# tldr (tealdeer) — colorized with pager
if command -v tldr &>/dev/null; then
  if [[ "$TERM" != "linux" && "$TERM" != "dumb" ]]; then
    tldr() { command tldr --color always "$@" | less -RFX; }
  else
    tldr() { command tldr --color never "$@" | less -FX; }
  fi
fi

# System
alias ports="ss -tulnp"
alias myip="curl -s ifconfig.me"
