# XDG base directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Make Python's requests/hvac/ansible community.hashi_vault and curl trust the
# labcore.local root CA (Vault at https://10.0.10.50:8200). The post-reimage
# system bundle does NOT include it and adding it needs root, so maintain a
# user-owned combined bundle (system bundle + labcore root), rebuilt whenever
# either input is newer. Falls back to the plain system bundle if the labcore
# CA (kept in the homenet-services repo) is missing.
_labcore_ca="$HOME/projects/homenet-services/ansible/roles/internal_ca_trust/files/labcore-root-ca.crt"
_ca_bundle=/etc/ssl/certs/ca-certificates.crt
if [ -r "$_ca_bundle" ] && [ -r "$_labcore_ca" ]; then
  _combined="$HOME/.local/share/labcore/ca-bundle.crt"
  if [ ! -r "$_combined" ] || [ "$_ca_bundle" -nt "$_combined" ] || [ "$_labcore_ca" -nt "$_combined" ]; then
    mkdir -p "${_combined%/*}" && cat "$_ca_bundle" "$_labcore_ca" > "$_combined"
  fi
  _ca_bundle="$_combined"
  unset _combined
fi
if [ -r "$_ca_bundle" ]; then
  export REQUESTS_CA_BUNDLE="$_ca_bundle"
  export SSL_CERT_FILE="$_ca_bundle"
  export CURL_CA_BUNDLE="$_ca_bundle"
fi
unset _labcore_ca _ca_bundle

# npm: install global packages under a user-owned prefix (~/.local, on PATH) so
# `npm i -g` and package self-updates don't need sudo — the default system
# prefix is root-owned /usr/local (which strands globals like http-server/yarn
# on any update). Skip when nvm is active: nvm manages its own per-version
# prefix and is incompatible with a fixed NPM_CONFIG_PREFIX.
if [ -z "$NVM_DIR" ]; then
    case "$(command -v npm 2>/dev/null)" in
        "$HOME"/.nvm/*) : ;;   # nvm-managed npm — leave the prefix to nvm
        "") : ;;               # no npm installed — nothing to configure
        *) export NPM_CONFIG_PREFIX="$HOME/.local" ;;
    esac
fi

# if running bash
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Go
if [ -d "/usr/local/go/bin" ] ; then
    PATH="/usr/local/go/bin:$PATH"
fi

if [ -d "$HOME/go/bin" ] ; then
    PATH="$HOME/go/bin:$PATH"
fi

# WSL-specific settings
if [ -n "$WSL_DISTRO_NAME" ]; then
    # Fix WSLg cursor size/rendering issues
    export XCURSOR_SIZE=24
    export GDK_SCALE=1
    export GDK_DPI_SCALE=1
fi
