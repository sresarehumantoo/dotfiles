# Sourced by bash for login shells, and by ~/.zprofile for zsh, which does not
# read this file on its own. The sentinel lets ~/.zprofile tell whether anything
# already sourced us (a display manager, say), because the PATH blocks below
# prepend unconditionally and a second pass would duplicate every entry.
# Exported so a child login shell sees it too.
export DF_PROFILE_SOURCED=1

# XDG base directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# CA bundle for tools that ignore the macOS keychain, written by the macOS
# bootstrap only when it finds a TLS-inspecting proxy. Ahead of Homebrew and
# everything else here that may reach the network.
if [ -r "$HOME/.config/dfinstall/ca.sh" ]; then
    . "$HOME/.config/dfinstall/ca.sh"
fi

# Homebrew on macOS: /opt/homebrew on Apple Silicon, /usr/local on Intel, and
# ~/homebrew for an account that cannot create either. Ahead of the npm block,
# which needs brew's npm on PATH to find it.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew "$HOME/homebrew/bin/brew"; do
    if [ -x "$_brew" ]; then
        eval "$("$_brew" shellenv)"
        break
    fi
done
unset _brew

# GNU userland ahead of Apple's BSD tools, so sed/grep/find/ls/tar/make behave
# as on Linux. A named list, not opt/*/libexec/gnubin: libtool has a gnubin too,
# and GNU libtool shadowing Apple's /usr/bin/libtool breaks native builds. Keep
# in step with macGNUFormulae (src/modules/packages.go) and zsh/path.zsh.
if [ -n "$HOMEBREW_PREFIX" ]; then
    for _gnu in coreutils findutils gnu-sed grep gawk gnu-tar make; do
        if [ -d "$HOMEBREW_PREFIX/opt/$_gnu/libexec/gnubin" ]; then
            PATH="$HOMEBREW_PREFIX/opt/$_gnu/libexec/gnubin:$PATH"
        fi
    done
    unset _gnu
    # Homebrew's rustup is keg-only; its bin carries the cargo/rustc proxies.
    if [ -d "$HOMEBREW_PREFIX/opt/rustup/bin" ]; then
        PATH="$HOMEBREW_PREFIX/opt/rustup/bin:$PATH"
    fi
fi

# npm: install global packages under a user-owned prefix (~/.local, on PATH) so
# `npm i -g` and package self-updates don't need sudo — the default system
# prefix is root-owned /usr/local (which strands globals like http-server/yarn
# on any update). Skip when nvm is active: nvm manages its own per-version
# prefix and is incompatible with a fixed NPM_CONFIG_PREFIX.
if [ -z "$NVM_DIR" ]; then
    case "$(command -v npm 2>/dev/null)" in
        "$HOME"/.nvm/*) : ;;   # nvm-managed npm — leave the prefix to nvm
        "") : ;;               # no npm installed — nothing to configure
        *) export NPM_CONFIG_PREFIX="$HOME/.local" ;;
    esac
fi

# if running bash
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Go
if [ -d "/usr/local/go/bin" ] ; then
    PATH="/usr/local/go/bin:$PATH"
fi

if [ -d "$HOME/go/bin" ] ; then
    PATH="$HOME/go/bin:$PATH"
fi

# Rust (rustup, installed with --no-modify-path)
if [ -d "$HOME/.cargo/bin" ] ; then
    PATH="$HOME/.cargo/bin:$PATH"
fi

# WSL-specific settings
if [ -n "$WSL_DISTRO_NAME" ]; then
    # Fix WSLg cursor size/rendering issues
    export XCURSOR_SIZE=24
    export GDK_SCALE=1
    export GDK_DPI_SCALE=1
fi

# Machine-local environment, sourced last so it can override anything above.
# This repo is public and configures workstations generally -- including ones
# that never touch a given private network -- so anything naming an internal
# host, IP, CA or repo path belongs in ~/.profile.local, which is untracked.
# Mirrors the ~/.gitconfig.local convention already used by config/git/gitconfig.
if [ -r "$HOME/.profile.local" ]; then
    . "$HOME/.profile.local"
fi
