#!/bin/sh
# SketchyBar: the macOS counterpart of config/waybar. Same glass strip, pills
# and Catppuccin colors; workspaces come from AeroSpace, which triggers the
# aerospace_* events below from config/aerospace/aerospace.toml.
#
# Run by the brew service under launchd, so PATH is Homebrew's bin plus the
# system dirs: Apple's /bin/sh and BSD userland, never bash 5 or GNU tools.
#
# Differences from waybar, all for want of a macOS equivalent: one workspace
# row shared by every display rather than one per output; the clock sits at
# the right edge because a centered item lands under the MacBook notch; no
# notification count, privacy indicator, media or temperature. The tray stays
# in the native menu bar, which is meant to be set to auto-hide so it shows on
# hover above this bar.

PLUGIN_DIR="$CONFIG_DIR/plugins"
. "$CONFIG_DIR/colors.sh"
FONT="IosevkaTerm Nerd Font"

sketchybar --bar position=top height=40 margin=10 y_offset=6 \
                 corner_radius=0 blur_radius=30 color="$BAR_TINT"

sketchybar --default \
  icon.font="$FONT:Regular:15.0" label.font="$FONT:Regular:13.0" \
  icon.color="$TEXT" label.color="$TEXT" \
  padding_left=4 padding_right=4 \
  icon.padding_left=6 icon.padding_right=6 \
  label.padding_left=4 label.padding_right=6

sketchybar --add event aerospace_workspace_change \
           --add event aerospace_focus_change \
           --add event aerospace_mode_change

for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$sid" left \
    --subscribe "space.$sid" aerospace_workspace_change aerospace_focus_change front_app_switched \
    --set "space.$sid" \
      icon.drawing=off label="$sid" label.padding_left=8 label.padding_right=8 \
      background.color="$GLASS_TINT" background.border_color="$GLASS_EDGE" \
      background.border_width=1 background.corner_radius=11 background.height=26 \
      background.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

sketchybar --add item mode left \
  --subscribe mode aerospace_mode_change \
  --set mode drawing=off label.color="$YELLOW" icon.drawing=off \
    script="$PLUGIN_DIR/mode.sh"

sketchybar --add bracket spaces '/space\..*/' mode \
  --set spaces background.color="$PILL" background.border_color="$PILL_BORDER" \
    background.border_width=1 background.corner_radius=16 background.height=32

# Right side is added from the edge inwards.
sketchybar \
  --add item clock right \
  --set clock icon=󰅐 update_freq=10 script="$PLUGIN_DIR/clock.sh" \
    click_script="open -a Calendar" \
  --add item battery right \
  --set battery update_freq=60 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke \
  --add item network right \
  --set network update_freq=10 label.drawing=off script="$PLUGIN_DIR/network.sh" \
    click_script='open "x-apple.systempreferences:com.apple.Network-Settings.extension"' \
  --subscribe network system_woke \
  --add item volume right \
  --set volume label.drawing=off script="$PLUGIN_DIR/volume.sh" \
    click_script='open "x-apple.systempreferences:com.apple.Sound-Settings.extension"' \
  --subscribe volume volume_change \
  --add item caffeinate right \
  --set caffeinate label.drawing=off script="$PLUGIN_DIR/caffeinate.sh" \
    click_script="$PLUGIN_DIR/caffeinate.sh toggle" \
  --add item vpn right \
  --set vpn label.drawing=off update_freq=10 icon=󰦝 script="$PLUGIN_DIR/vpn.sh" \
  --subscribe vpn system_woke

sketchybar --add bracket status clock battery network volume caffeinate vpn \
  --set status background.color="$PILL" background.border_color="$PILL_BORDER" \
    background.border_width=1 background.corner_radius=16 background.height=32

sketchybar --update
